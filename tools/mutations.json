{
  "change": "Name a repeated slip as a pattern, and say when its trap is walked past",
  "mutations": [
    { "name": "a second slip is not yet called a pattern",
      "file": "index.html",
      "find": "    if(n<2) return '';",
      "replace": "    if(n<3) return '';",
      "run": "play:slips" },
    { "name": "numbers are left in, so each question is a new slip",
      "file": "index.html",
      "find": ".replace(/[−-]?\\d+(\\.\\d+)?/g,'#')\n      .replace(/\\(#\\)/g,'#')",
      "replace": "\n      .replace(/\\(#\\)/g,'#')",
      "run": "play:slips" },
    { "name": "brackets split one slip into two",
      "file": "index.html",
      "find": ".replace(/\\(#\\)/g,'#').replace(/\\s+/g,' ')",
      "replace": ".replace(/\\s+/g,' ')",
      "run": "play:slips" },
    { "name": "walking past the trap does not restart the count",
      "file": "index.html",
      "find": "      if(b[g]>0){ b[g]=0; seen=true; }",
      "replace": "      if(b[g]>0){ seen=true; }",
      "run": "play:slips" },
    { "name": "every knight shares one book",
      "file": "index.html",
      "find": "    const k=this.log[who] || (this.log[who]={});",
      "replace": "    const k=this.log._ || (this.log._={});",
      "run": "play:slips" },
    { "name": "every topic shares one count",
      "file": "index.html",
      "find": "    return k[key] || (k[key]={});",
      "replace": "    return k._all || (k._all={});",
      "run": "play:slips" },
    { "name": "a fight never shows the note",
      "file": "index.html",
      "find": "${miss}.</div>`:'')+ slipNote +",
      "replace": "${miss}.</div>`:'')+",
      "run": "play:slips" },
    { "name": "the yard never shows the note",
      "file": "index.html",
      "find": "${miss}.</div>`:''}${slipNote}",
      "replace": "${miss}.</div>`:''}",
      "run": "play:slips" }
  ]
}
