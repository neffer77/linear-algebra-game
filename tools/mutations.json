{
  "change": "Add a Saga: a chapter of the story told as each realm's boss falls",
  "mutations": [
    {
      "name": "a chapter is given away before its boss falls",
      "file": "index.html",
      "find": "REALMS.map((r,ri)=>this.read(ri)?this.card(ri,'saga-'+ri):this.locked(ri))",
      "replace": "REALMS.map((r,ri)=>this.card(ri,'saga-'+ri))",
      "run": "verify"
    },
    {
      "name": "a rematch tells the chapter again",
      "file": "index.html",
      "find": "${this.foe.boss&&first?Saga.card(this.ri):''}",
      "replace": "${this.foe.boss?Saga.card(this.ri):''}",
      "run": "verify"
    },
    {
      "name": "a realm's first foe reads its chapter",
      "file": "index.html",
      "find": "g.cleared[ri+':'+(REALMS[ri].foes.length-1)]); },\n  count()",
      "replace": "g.cleared[ri+':0']); },\n  count()",
      "run": "verify"
    },
    {
      "name": "the count runs one ahead",
      "file": "index.html",
      "find": "return REALMS.filter((r,ri)=>this.read(ri)).length; }",
      "replace": "return REALMS.filter((r,ri)=>this.read(ri)).length+1; }",
      "run": "verify"
    },
    {
      "name": "the boss is drawn as a shadow",
      "file": "index.html",
      "find": "Bestiary.shot(c, this.boss(+c.dataset.saga), true)",
      "replace": "Bestiary.shot(c, this.boss(+c.dataset.saga), false)",
      "run": "verify"
    },
    {
      "name": "the victory never draws the boss",
      "file": "index.html",
      "find": "      if(this.foe.boss&&first) Saga.paint(document.getElementById('resultBody'));\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the opening is left off the page",
      "file": "index.html",
      "find": "${OPENING.map(o=>o.b).join(' ')}",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the map has no way to the Saga",
      "file": "index.html",
      "find": "        <button class=\"btn sm ghost\" onclick=\"UI.go('s-saga')\" id=\"btnSaga\">📜 Saga</button>",
      "replace": "",
      "run": "play:saga"
    }
  ]
}