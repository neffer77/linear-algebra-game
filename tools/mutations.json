{
  "change": "A shorter Saga: only the next chapter keeps its card, and the ones further on wait in one short list",
  "mutations": [
    {
      "name": "every unread chapter gets a card again",
      "file": "index.html",
      "find": "this.card(ri,'saga-'+ri):ri===next?this.locked(ri):'').join('')+",
      "replace": "this.card(ri,'saga-'+ri):this.locked(ri)).join('')+",
      "run": "verify"
    },
    {
      "name": "the short list is never drawn",
      "file": "index.html",
      "find": "      this.far(next);\n    this.paint(list);",
      "replace": "      '';\n    this.paint(list);",
      "run": "verify"
    },
    {
      "name": "the next chapter is the first, read or not",
      "file": "index.html",
      "find": "  next(){ return REALMS.findIndex((r,ri)=>!this.read(ri)); },",
      "replace": "  next(){ return 0; },",
      "run": "verify"
    },
    {
      "name": "the short list lists the next chapter too",
      "file": "index.html",
      "find": "    const ris=REALMS.map((r,ri)=>ri).filter(ri=>ri!==next && !this.read(ri));",
      "replace": "    const ris=REALMS.map((r,ri)=>ri).filter(ri=>!this.read(ri));",
      "run": "verify"
    },
    {
      "name": "the short list lists chapters read",
      "file": "index.html",
      "find": "    const ris=REALMS.map((r,ri)=>ri).filter(ri=>ri!==next && !this.read(ri));",
      "replace": "    const ris=REALMS.map((r,ri)=>ri).filter(ri=>ri!==next);",
      "run": "verify"
    },
    {
      "name": "every unread chapter gets a card again, seen in play",
      "file": "index.html",
      "find": "this.card(ri,'saga-'+ri):ri===next?this.locked(ri):'').join('')+",
      "replace": "this.card(ri,'saga-'+ri):this.locked(ri)).join('')+",
      "run": "play:saga"
    },
    {
      "name": "the short list rows run tall, seen in play",
      "file": "index.html",
      "find": ".sagaFar{font-size:13px;padding:5px 0 0;",
      "replace": ".sagaFar{font-size:13px;padding:40px 0 0;",
      "run": "play:saga"
    }
  ]
}