{
 "change": "The Best Fit Workshop: the line that misses least",
 "mutations": [
  {
   "name": "a miss is the line minus the point",
   "file": "index.html",
   "find": "misses(mh=this.mh, ch=this.ch){ return this.P().map(([x,y])=>y-this.at(x,mh,ch)); },",
   "replace": "misses(mh=this.mh, ch=this.ch){ return this.P().map(([x,y])=>this.at(x,mh,ch)-y); },",
   "run": "verify"
  },
  {
   "name": "the total adds sizes, not squares",
   "file": "index.html",
   "find": "sse(mh=this.mh, ch=this.ch){ return this.misses(mh,ch).reduce((s,r)=>s+r*r,0); },",
   "replace": "sse(mh=this.mh, ch=this.ch){ return this.misses(mh,ch).reduce((s,r)=>s+Math.abs(r),0); },",
   "run": "verify"
  },
  {
   "name": "the best line is sought at this c only",
   "file": "index.html",
   "find": "for(let ch=this.CLO; ch<=this.CHI; ch++) lo=Math.min(lo, this.sse(mh,ch));",
   "replace": "for(let ch=this.ch; ch<=this.ch; ch++) lo=Math.min(lo, this.sse(mh,ch));",
   "run": "verify"
  },
  {
   "name": "the average point divides by one too few",
   "file": "index.html",
   "find": "yb=P.reduce((s,p)=>s+p[1],0)/n;",
   "replace": "yb=P.reduce((s,p)=>s+p[1],0)/(n-1);",
   "run": "verify"
  },
  {
   "name": "a negative height is not bracketed",
   "file": "index.html",
   "find": "par(n){ return n<0 ? `(${this.num(n)})` : this.num(n); },",
   "replace": "par(n){ return this.num(n); },",
   "run": "verify"
  },
  {
   "name": "the line reads + − for a negative c",
   "file": "index.html",
   "find": "c<0 ? ' − '+this.num(-c) : '');",
   "replace": "c<0 ? ' + '+this.num(c) : '');",
   "run": "verify"
  },
  {
   "name": "m down reports m up's total",
   "file": "index.html",
   "find": "nb.push(`m down gives ${this.num(this.sse(this.mh-1,this.ch))}`);",
   "replace": "nb.push(`m down gives ${this.num(this.sse(this.mh+1,this.ch))}`);",
   "run": "verify"
  },
  {
   "name": "the far point's tilt is told on the scatter",
   "file": "index.html",
   "find": "(this.si===2 ? ` The far point at",
   "replace": "(this.si===1 ? ` The far point at",
   "run": "verify"
  },
  {
   "name": "a new set puts m and c back",
   "file": "index.html",
   "find": "pick(i){ this.si=i; this.touched=true; this.render(); },",
   "replace": "pick(i){ this.si=i; this.mh=1; this.ch=0; this.touched=true; this.render(); },",
   "run": "play:fit"
  },
  {
   "name": "m stops at 1.5",
   "file": "index.html",
   "find": "MLO:-4, MHI:4, CLO:-6, CHI:6,",
   "replace": "MLO:-4, MHI:3, CLO:-6, CHI:6,",
   "run": "play:fit"
  },
  {
   "name": "a miss of 0 gets an arrow",
   "file": "index.html",
   "find": "r[i] ? {v:[0,r[i]], from:[x,this.at(x)]",
   "replace": "true ? {v:[0,r[i]], from:[x,this.at(x)]",
   "run": "play:fit"
  },
  {
   "name": "the caption drops the arrows",
   "file": "index.html",
   "find": "the blue line is ${this.line()}; each red arrow is a miss, from the line to its point.`},",
   "replace": "the blue line is ${this.line()}.`},",
   "run": "play:fit"
  },
  {
   "name": "a found goal gives no toast",
   "file": "index.html",
   "find": "else { UI.toast('✓ '+fresh.map(g=>g.toast).join(' · ')); Sfx.good(); }\n    }\n  }\n};\n\n/* ============ ORDER MATTERS",
   "replace": "else { Sfx.good(); }\n    }\n  }\n};\n\n/* ============ ORDER MATTERS",
   "run": "play:fit"
  },
  {
   "name": "m and c lose their names",
   "file": "index.html",
   "find": "<b aria-label=\"${w}, ${nm[w].slice(0,-2)}: ${this.num(val[w])}\">",
   "replace": "<b>",
   "run": "play:fit"
  },
  {
   "name": "misses that add to 0 count even on the best line",
   "file": "index.html",
   "find": "ok:F=>F.total()===0 && !F.best()}",
   "replace": "ok:F=>F.total()===0}",
   "run": "play:fit"
  },
  {
   "name": "raising m never stops",
   "file": "index.html",
   "find": "hi={m:this.mh>=this.MHI,",
   "replace": "hi={m:false,",
   "run": "play:fit"
  }
 ]
}