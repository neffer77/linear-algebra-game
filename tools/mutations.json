{
  "change": "Never leave a returning player on an old build",
  "mutations": [
    {
      "name": "a build already waiting is never offered",
      "file": "index.html",
      "run": "play:pwa",
      "find": "      if(reg.waiting && navigator.serviceWorker.controller) Keep.offerUpdate(reg.waiting);\n",
      "replace": "\n"
    },
    {
      "name": "the new worker fills its cache through the HTTP cache",
      "file": "sw.js",
      "run": "play:pwa",
      "find": "c.add(new Request(u, { cache: 'reload' }))",
      "replace": "c.add(u)"
    },
    {
      "name": "a game left open never looks for a new build",
      "file": "index.html",
      "run": "play:pwa",
      "find": "        if(document.visibilityState==='visible') reg.update().catch(()=>{});",
      "replace": "        if(document.visibilityState==='visible') void reg;"
    }
  ]
}
