{
  "change": "Walk the fence, the hillwalker workshop's third mode",
  "mutations": [
    {
      "name": "λ worked from the wrong part of ∇f",
      "file": "index.html",
      "find": "const lam=Hill.fr(A,S.p);",
      "replace": "const lam=Hill.fr(B,S.p);",
      "run": "verify"
    },
    {
      "name": "the slope along the fence with a sign turned",
      "file": "index.html",
      "find": "return A*v[0]+B*v[1]; },",
      "replace": "return A*v[0]-B*v[1]; },",
      "run": "verify"
    },
    {
      "name": "the nearest post measured by x alone",
      "file": "index.html",
      "find": "d=t=>this.at(t)[0]**2+this.at(t)[1]**2;",
      "replace": "d=t=>Math.abs(this.at(t)[0]);",
      "run": "verify"
    },
    {
      "name": "∇f drawn along ∇g",
      "file": "index.html",
      "find": "out+=arrow(len*A/n, len*B/n, FIG_COL.b, 'grad', true);",
      "replace": "out+=arrow(len*S.p/m, len*S.q/m, FIG_COL.b, 'grad', true);",
      "run": "verify"
    },
    {
      "name": "∇f no longer dashed",
      "file": "index.html",
      "find": "out+=arrow(len*A/n, len*B/n, FIG_COL.b, 'grad', true);",
      "replace": "out+=arrow(len*A/n, len*B/n, FIG_COL.b, 'grad', false);",
      "run": "verify"
    },
    {
      "name": "the lowest contour drawn bold",
      "file": "index.html",
      "find": "stroke-width=\"${c===F?2.5:1}\" opacity=\"${c===F?1:0.5}\"",
      "replace": "stroke-width=\"${c===L[0]?2.5:1}\" opacity=\"${c===F?1:0.5}\"",
      "run": "verify"
    },
    {
      "name": "the post on read one short of the end",
      "file": "index.html",
      "find": "if(t<S.T[1]) nb.push",
      "replace": "if(t<S.T[1]-1) nb.push",
      "run": "verify"
    },
    {
      "name": "the walk-on button shut a post early",
      "file": "index.html",
      "find": "${t>=S.T[1]?' disabled':''}",
      "replace": "${t>=S.T[1]-1?' disabled':''}",
      "run": "verify"
    },
    {
      "name": "walking back past the first post",
      "file": "index.html",
      "find": "if(t<S.T[0]||t>S.T[1]) return;",
      "replace": "if(t<S.T[0]-1||t>S.T[1]) return;",
      "run": "verify"
    },
    {
      "name": "the x-axis crossing not told",
      "file": "index.html",
      "find": "if(D && (x===0 || y===0))",
      "replace": "if(D && x===0)",
      "run": "verify"
    },
    {
      "name": "the oval bowl made rounder",
      "file": "index.html",
      "find": "{btn:'Oval bowl', a:1, b:3,",
      "replace": "{btn:'Oval bowl', a:1, b:2,",
      "run": "verify"
    },
    {
      "name": "a contour left out",
      "file": "index.html",
      "find": "const L=[...new Set(posts.map(p=>this.f(...p)))]",
      "replace": "const L=[...new Set(posts.slice(1).map(p=>this.f(...p)))]",
      "run": "verify"
    }
  ]
}