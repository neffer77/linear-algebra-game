{
  "change": "The gauntlet: a realm all beaten runs again back to back for every first-clear purse",
  "mutations": [
    {
      "name": "a realm not all beaten offers a gauntlet",
      "file": "index.html",
      "find": "r.foes.every((f,fi)=>!!g.cleared[ri+':'+fi]);",
      "replace": "r.foes.some((f,fi)=>!!g.cleared[ri+':'+fi]);",
      "run": "verify"
    },
    {
      "name": "a gauntlet pays again and again",
      "file": "index.html",
      "find": "this.run=null; this.paid[r.ri]=1; g.gold+=gold;",
      "replace": "this.run=null; g.gold+=gold;",
      "run": "verify"
    },
    {
      "name": "a gauntlet pays nothing",
      "file": "index.html",
      "find": "this.run=null; this.paid[r.ri]=1; g.gold+=gold;",
      "replace": "this.run=null; this.paid[r.ri]=1;",
      "run": "verify"
    },
    {
      "name": "a gauntlet starts at its second foe",
      "file": "index.html",
      "find": "    this.run={ri, i:0};\n    Battle.begin(ri, 0);",
      "replace": "    this.run={ri, i:1};\n    Battle.begin(ri, 1);",
      "run": "verify"
    },
    {
      "name": "a heroic fight keeps the run",
      "file": "index.html",
      "find": "meet(ri, fi, extra){ if(this.run && (extra || ri!==this.run.ri",
      "replace": "meet(ri, fi, extra){ if(this.run && (ri!==this.run.ri",
      "run": "verify"
    },
    {
      "name": "any foe of the realm steps the run on",
      "file": "index.html",
      "find": "B.ri!==r.ri || B.fi!==r.i || !g) return null;",
      "replace": "B.ri!==r.ri || !g) return null;",
      "run": "verify"
    },
    {
      "name": "the arena steps the run on",
      "file": "index.html",
      "find": "if(!r || !B || B.mode!=='campaign' || B.ri",
      "replace": "if(!r || !B || B.ri",
      "run": "verify"
    },
    {
      "name": "the purse is the boss's alone",
      "file": "index.html",
      "find": "purse(ri){ return REALMS[ri].foes.reduce((a,f)=>a+f.gold, 0); },",
      "replace": "purse(ri){ const f=REALMS[ri].foes; return f[f.length-1].gold; },",
      "run": "verify"
    },
    {
      "name": "a fall keeps the run",
      "file": "index.html",
      "find": "    Gauntlet.end();   // a fall breaks off a gauntlet run\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "in play, a flight keeps the run",
      "file": "index.html",
      "find": "    if(live) Gauntlet.end();   // so does a flight from a live fight\n",
      "replace": "",
      "run": "play:gauntlet"
    },
    {
      "name": "in play, the card does not lead on",
      "file": "index.html",
      "find": "        ${Gauntlet.button(gnt)}\n",
      "replace": "",
      "run": "play:gauntlet"
    },
    {
      "name": "in play, the map offers no gauntlet",
      "file": "index.html",
      "find": "      realms+=Gauntlet.node(ri);   // a gauntlet to run, or one under way\n",
      "replace": "",
      "run": "play:gauntlet"
    }
  ]
}