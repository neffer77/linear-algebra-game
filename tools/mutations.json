{
  "change": "Add a Rising or falling mode to the product rule workshop",
  "mutations": [
    {
      "name": "the slope keeps only f′g",
      "file": "index.html",
      "find": "slope(i){ return this.fp(i)*this.ga(i)+this.fa(i)*this.gp(i); },",
      "replace": "slope(i){ return this.fp(i)*this.ga(i); },",
      "run": "verify"
    },
    {
      "name": "the slope is f′g′",
      "file": "index.html",
      "find": "truth(i){ return Math.sign(this.slope(i)); },",
      "replace": "truth(i){ return Math.sign(this.fp(i)*this.gp(i)); },",
      "run": "verify"
    },
    {
      "name": "f′ of x² loses its 2",
      "file": "index.html",
      "find": "sq: {s:'x²',     d:'2x', f:x=>x*x,     fp:x=>2*x},",
      "replace": "sq: {s:'x²',     d:'2x', f:x=>x*x,     fp:x=>x},",
      "run": "verify"
    },
    {
      "name": "a fall from two rises needs only one",
      "file": "index.html",
      "find": "boths(){ return [0,1,2,3].filter(i=>this.truth(i)===-1 && this.fp(i)>0 && this.gp(i)>0); },",
      "replace": "boths(){ return [0,1,2,3].filter(i=>this.truth(i)===-1 && (this.fp(i)>0 || this.gp(i)>0)); },",
      "run": "verify"
    },
    {
      "name": "y is drawn before the round is right",
      "file": "index.html",
      "find": "if(this.solved){\n        out+=line('y'",
      "replace": "if(true){\n        out+=line('y'",
      "run": "verify"
    },
    {
      "name": "y is drawn as f + g",
      "file": "index.html",
      "find": "y(i,x){ return this.Fn(i).f(x)*this.Gn(i).f(x); },",
      "replace": "y(i,x){ return this.Fn(i).f(x)+this.Gn(i).f(x); },",
      "run": "verify"
    },
    {
      "name": "the tangent leans the other way",
      "file": "index.html",
      "find": "y2=\"${f(py(y0+0.8*m))}\"",
      "replace": "y2=\"${f(py(y0-0.8*m))}\"",
      "run": "verify"
    },
    {
      "name": "a call still moves once the round is right",
      "file": "index.html",
      "find": "if(this.solved || this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    Product.render();",
      "replace": "if(this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    Product.render();",
      "run": "verify"
    }
  ]
}