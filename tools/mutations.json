      "find": "y1=\"${f(this.PY(P+R*(t1-t)))}\" x2=\"${f(this.PX(t2))}\" y2=\"${f(this.PY(P+R*(t2-t)))}\"",
      "replace": "y1=\"${f(this.PY(P+2*R*(t1-t)))}\" x2=\"${f(this.PX(t2))}\" y2=\"${f(this.PY(P+2*R*(t2-t)))}\"",
      "run": "verify"
    },
    {
      "name": "the dots stop a step short",
      "file": "index.html",
      "find": "for(let k=0;k<=t;k++) out+=`<circle",
      "replace": "for(let k=0;k<t;k++) out+=`<circle",
      "run": "verify"
    },
    {
      "name": "the curve runs to t = 10",
      "file": "index.html",
      "find": "for(let i=0;i<=160;i++){ const t=this.TMAX*i/160;",
      "replace": "for(let i=0;i<=160;i++){ const t=this.TMAX*i/320;",
      "run": "verify"
    },
    {
      "name": "the early goal needs two steps",
      "file": "index.html",
      "find": "ok:K=>K.si===0 && K.stepped && K.t===1},",
      "replace": "ok:K=>K.si===0 && K.stepped && K.t===2},",
      "run": "verify"
    },
    {
      "name": "the slow goal counts a rising rate",
