{
  "change": "Show which answer is picked in every answer row",
  "mutations": [
    {
      "name": "no rule turns a pressed answer gold",
      "file": "index.html",
      "find": ".btn.ghost[aria-pressed=\"true\"]{border-color:var(--gold);color:var(--gold);box-shadow:0 0 0 1px var(--gold) inset;background:rgba(242,193,78,.12)}\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "a pressed answer keeps its plain border",
      "file": "index.html",
      "find": ".btn.ghost[aria-pressed=\"true\"]{border-color:var(--gold);color:var(--gold);box-shadow:0 0 0 1px var(--gold) inset;background:rgba(242,193,78,.12)}",
      "replace": ".btn.ghost[aria-pressed=\"true\"]{color:var(--gold);box-shadow:0 0 0 1px var(--gold) inset;background:rgba(242,193,78,.12)}",
      "run": "verify"
    },
    {
      "name": "a pressed answer keeps its plain text",
      "file": "index.html",
      "find": ".btn.ghost[aria-pressed=\"true\"]{border-color:var(--gold);color:var(--gold);box-shadow:0 0 0 1px var(--gold) inset;background:rgba(242,193,78,.12)}",
      "replace": ".btn.ghost[aria-pressed=\"true\"]{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold) inset;background:rgba(242,193,78,.12)}",
      "run": "verify"
    },
    {
      "name": "the in or out answers are not ghost buttons",
      "file": "index.html",
      "find": "<button class=\"btn sm ghost\" style=\"margin:0;padding:4px 2px\" data-c=\"${c}\" aria-pressed=\"${this.calls[i]===c}\" ${this.solved?'disabled ':''}onclick=\"CrossTurn",
      "replace": "<button class=\"btn sm\" style=\"margin:0;padding:4px 2px\" data-c=\"${c}\" aria-pressed=\"${this.calls[i]===c}\" ${this.solved?'disabled ':''}onclick=\"CrossTurn",
      "run": "verify"
    }
  ]
}