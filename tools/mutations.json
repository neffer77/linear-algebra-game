{
  "change": "The sitting's tally: the map counts this sitting's victories, gold and best streak",
  "mutations": [
    {
      "name": "the tally counts every mode",
      "file": "index.html",
      "find": "    if(!B || B.mode!=='campaign') return false;\n    this.wins++;",
      "replace": "    if(!B) return false;\n    this.wins++;",
      "run": "verify"
    },
    {
      "name": "the tally keeps the last streak, not the best",
      "file": "index.html",
      "find": "this.best=Math.max(this.best, B.runBest||0);",
      "replace": "this.best=B.runBest||0;",
      "run": "verify"
    },
    {
      "name": "the tally leaves the gold out",
      "file": "index.html",
      "find": "this.gold+=Math.max(0, gold|0);",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the map shows a tally of nothing",
      "file": "index.html",
      "find": "    if(!this.wins) return '';\n    return `<div class=\"small center\" id=\"sittingTally\"",
      "replace": "    return `<div class=\"small center\" id=\"sittingTally\"",
      "run": "verify"
    },
    {
      "name": "the tally says one victories",
      "file": "index.html",
      "find": "${this.wins===1?'victory':'victories'}",
      "replace": "victories",
      "run": "verify"
    },
    {
      "name": "the tally is fed only the win's own gold",
      "file": "index.html",
      "find": "Sitting.won(this, gold+sGold+oGold+rGold+bGold+cGold);",
      "replace": "Sitting.won(this, gold);",
      "run": "play:sitting"
    },
    {
      "name": "a win does not count in the tally",
      "file": "index.html",
      "find": "\n    Sitting.won(this, gold+sGold+oGold+rGold+bGold+cGold);",
      "replace": "",
      "run": "play:sitting"
    },
    {
      "name": "the map does not show the tally",
      "file": "index.html",
      "find": "let realms=Sitting.html()+Quarry.node(quarry)",
      "replace": "let realms=Quarry.node(quarry)",
      "run": "play:sitting"
    }
  ]
}