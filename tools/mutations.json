      "find": "if(S.id==='small' && t===1) note+=",
      "replace": "if(S.id==='small' && t>=1) note+=",
      "run": "verify"
    },
    {
      "name": "the rate is said to rise when it falls",
      "file": "index.html",
      "find": "out.push(R<R0 ? `The rate fell",
      "replace": "out.push(R>R0 ? `The rate fell",
      "run": "verify"
    },
    {
      "name": "K/2 is passed at 400",
      "file": "index.html",
      "find": "if(P0<500 && P>=500) out.push(",
      "replace": "if(P0<400 && P>=400) out.push(",
      "run": "verify"
    },
    {
