{
 "change": "Straight on: a campaign victory offers the next fight on the road",
 "mutations": [
  {
   "name": "the fight just won is offered again",
   "file": "index.html",
   "find": "return nx && !(nx.ri===ri && nx.fi===fi) ? nx : null;",
   "replace": "return nx;",
   "run": "verify"
  },
  {
   "name": "the war path pay is the one just won",
   "file": "index.html",
   "find": "Win it for <b>+${WarPath.pct(n+1)}%</b>",
   "replace": "Win it for <b>+${WarPath.pct(n)}%</b>",
   "run": "verify"
  },
  {
   "name": "a first victory talks of a war path",
   "file": "index.html",
   "find": "const path=n>=1 ? ",
   "replace": "const path=n>=0 ? ",
   "run": "verify"
  },
  {
   "name": "a rest is offered that cannot be paid",
   "file": "index.html",
   "find": "+(low.afford?`<button class=\"btn\" id=\"nextRest\"",
   "replace": "+(true?`<button class=\"btn\" id=\"nextRest\"",
   "run": "verify"
  },
  {
   "name": "a refused rest takes the offer away",
   "file": "index.html",
   "find": "    if(!Game.rest()) return false;\n    btn.remove();",
   "replace": "    Game.rest();\n    btn.remove();",
   "run": "verify"
  },
  {
   "name": "the button starts the fight just won",
   "file": "index.html",
   "find": "id=\"nextGo\" onclick=\"Battle.begin(${nx.ri},${nx.fi})\"",
   "replace": "id=\"nextGo\" onclick=\"Battle.begin(0,0)\"",
   "run": "verify"
  },
  {
   "name": "the arena offers the next fight too",
   "file": "index.html",
   "find": "const nx=this.mode==='campaign' ? NextFight.of(this.ri, this.fi) : null;",
   "replace": "const nx=NextFight.of(this.ri, this.fi);",
   "run": "verify"
  },
  {
   "name": "the map keeps its gold beside the next fight",
   "file": "index.html",
   "find": "<button class=\"btn${nx?'':' gold'}\" onclick=\"UI.go('s-map')\">",
   "replace": "<button class=\"btn gold\" onclick=\"UI.go('s-map')\">",
   "run": "verify"
  },
  {
   "name": "the warning stays after a rest",
   "file": "index.html",
   "find": "btn.remove(); const l=document.getElementById('nextLow'); if(l) l.remove();",
   "replace": "btn.remove();",
   "run": "play:nextfight"
  }
 ]
}
