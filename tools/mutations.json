      "run": "verify"
    },
    {
      "name": "never dazed",
      "file": "index.html",
      "find": "      if(B.over==='win') Daze.draw(605, gy, B.foe.boss?1.55:1.28, Anim.t);   // stars round a beaten foe's head\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "never dazed, seen in play",
      "file": "index.html",
      "find": "      if(B.over==='win') Daze.draw(605, gy, B.foe.boss?1.55:1.28, Anim.t);   // stars round a beaten foe's head\n",
      "replace": "",
      "run": "play:scars"
    },
    {
      "name": "dazed while still fighting, seen in play",
      "file": "index.html",
      "find": "      if(B.over==='win') Daze.draw(605, gy, B.foe.boss?1.55:1.28, Anim.t);",
      "replace": "      Daze.draw(605, gy, B.foe.boss?1.55:1.28, Anim.t);",
      "run": "play:scars"
