{
  "change": "What a foe says mid-fight is repeated in the verdict",
  "mutations": [
    {
      "name": "the verdict never repeats what the foe said",
      "file": "index.html",
      "find": "      (Talk.turn && !inRite ? `<div class=\"foesay\"",
      "replace": "      (false && Talk.turn ? `<div class=\"foesay\"",
      "run": "play:talk"
    },
    {
      "name": "screen readers read the repeated line out",
      "file": "index.html",
      "find": "<div class=\"foesay\" aria-hidden=\"true\">",
      "replace": "<div class=\"foesay\">",
      "run": "play:talk"
    },
    {
      "name": "a line said on an earlier turn is repeated in a later verdict",
      "file": "index.html",
      "find": "    this.answered=true; clearInterval(this.timer);\n    Talk.turn=null;\n",
      "replace": "    this.answered=true; clearInterval(this.timer);\n",
      "run": "play:talk"
    },
    {
      "name": "what the foe says is not kept for the verdict",
      "file": "index.html",
      "find": "    this.turn={moment, text};\n",
      "replace": "",
      "run": "play:talk"
    }
  ]
}
