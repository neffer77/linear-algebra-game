{
  "change": "Euler's method as a fight topic: estimate y two or three steps on from y′ = px + qy.",
  "mutations": [
    {
      "name": "a step adds the whole slope",
      "file": "index.html",
      "find": "const y1=add(y, how==='noH'?s:mul(h,s));",
      "replace": "const y1=add(y, s);",
      "run": "verify"
    },
    {
      "name": "every step reads its slope at the far end",
      "file": "index.html",
      "find": "at=how==='far'?F(k+1,hd):x;",
      "replace": "at=F(k+1,hd);",
      "run": "verify"
    },
    {
      "name": "the slope swaps its two coefficients",
      "file": "index.html",
      "find": "add(mul(F(p),x),mul(F(q),y))",
      "replace": "add(mul(F(q),x),mul(F(p),y))",
      "run": "verify"
    },
    {
      "name": "the slope forgets x",
      "file": "index.html",
      "find": "add(mul(F(p),x),mul(F(q),y))",
      "replace": "mul(F(q),y)",
      "run": "verify"
    },
    {
      "name": "the answer is one step short",
      "file": "index.html",
      "find": "A=W[n-1].y1;",
      "replace": "A=W[n-2].y1;",
      "run": "verify"
    },
    {
      "name": "the four wrong answers may coincide",
      "file": "index.html",
      "find": "new Set(keys).size!==5 || ",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "a wrong answer may be 0",
      "file": "index.html",
      "find": "dist.some(x=>x[0][0]===0) || ",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the question says the wrong step",
      "file": "index.html",
      "find": "step h = ${show(h)} on",
      "replace": "step h = ${show(F(1))} on",
      "run": "verify"
    },
    {
      "name": "the question says the wrong start",
      "file": "index.html",
      "find": "starting from y(0) = ${show(y0)}.",
      "replace": "starting from y(0) = ${show(F(1))}.",
      "run": "verify"
    },
    {
      "name": "the question asks for the wrong point",
      "file": "index.html",
      "find": "What is its estimate of y(${show(F(n,hd))})?",
      "replace": "What is its estimate of y(${show(F(n,1))})?",
      "run": "verify"
    },
    {
      "name": "the equation flips the sign of y",
      "file": "index.html",
      "find": "${q<0?'−':'+'} ${Math.abs(q)=",
      "replace": "${q<0?'+':'−'} ${Math.abs(q)=",
      "run": "verify"
    },
    {
      "name": "the equation writes 1y",
      "file": "index.html",
      "find": "${Math.abs(q)===1?'':Math.abs(q)}y",
      "replace": "${Math.abs(q)}y",
      "run": "verify"
    },
    {
      "name": "the equation writes 1x",
      "file": "index.html",
      "find": "${p===1?'':p===-1?'−':neg(p)}x ",
      "replace": "${neg(p)}x ",
      "run": "verify"
    },
    {
      "name": "the working skips a step",
      "file": "index.html",
      "find": "work.join(' ')",
      "replace": "work.slice(1).join(' ')",
      "run": "verify"
    },
    {
      "name": "the working lands a step in the wrong place",
      "file": "index.html",
      "find": "= ${show(st.y1)}.`",
      "replace": "= ${show(st.y)}.`",
      "run": "verify"
    },
    {
      "name": "the step-size slip is offered when h is 1",
      "file": "index.html",
      "find": "if(hd>1) dist.push",
      "replace": "if(hd>0) dist.push",
      "run": "verify"
    },
    {
      "name": "the answer is shown as a decimal",
      "file": "index.html",
      "find": "a:show(A),",
      "replace": "a:String(A[0]/A[1]),",
      "run": "verify"
    },
    {
      "name": "the codex has no example",
      "file": "index.html",
      "find": "eg:'y′ = y from y(0) = 1 with h = 1/2: 1 → 1 + 1/2 × 1 = 3/2 → 3/2 + 1/2 × 3/2 = 9/4.'",
      "replace": "eg:''",
      "run": "verify"
    },
    {
      "name": "a wrong answer has no reason",
      "file": "index.html",
      "find": "d:dist.map(([v,why])=>[show(v),why]),",
      "replace": "d:dist.map(([v,why])=>[show(v),'']),",
      "run": "verify"
    },
    {
      "name": "Euler's method has no name",
      "file": "index.html",
      "find": ", euler:\"Euler's Method\"",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "no realm asks Euler's method",
      "file": "index.html",
      "find": "'secondDeriv','euler'],",
      "replace": "'secondDeriv'],",
      "run": "verify"
    },
    {
      "name": "Euler's method is in no strand",
      "file": "index.html",
      "find": ",'optimisation','euler']]",
      "replace": ",'optimisation']]",
      "run": "verify"
    },
    {
      "name": "an old code loses its history",
      "file": "index.html",
      "find": "if(sig!==this.sig() && !(nTop<T.length && sig===this.sigOf(nTop))){",
      "replace": "if(sig!==this.sig()){",
      "run": "verify"
    },
    {
      "name": "an old code is read against the whole list",
      "file": "index.html",
      "find": "sig===this.sigOf(nTop))",
      "replace": "sig===this.sigOf(T.length))",
      "run": "verify"
    },
    {
      "name": "the signature hashes one topic too many",
      "file": "index.html",
      "find": "this.topics().slice(0,n).join(',')",
      "replace": "this.topics().slice(0,n+1).join(',')",
      "run": "verify"
    }
  ]
}