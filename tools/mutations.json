{
  "change": "Titles for grades: Exemplar, Crowned and Paragon",
  "mutations": [
    {
      "name": "Exemplar at nine",
      "file": "index.html",
      "find": "t:g=>Grade.countS(g.cleared)>=10}",
      "replace": "t:g=>Grade.countS(g.cleared)>=9}",
      "run": "verify"
    },
    {
      "name": "an old clear counts as S",
      "file": "index.html",
      "find": "countS(cleared){ return Object.values(cleared||{}).filter(v=>v==='S').length; },",
      "replace": "countS(cleared){ return Object.values(cleared||{}).filter(v=>v==='S'||v===true).length; },",
      "run": "verify"
    },
    {
      "name": "Crowned needs every realm",
      "file": "index.html",
      "find": "    t:g=>REALMS.some((r,ri)=>Grade.crowned(g.cleared, ri, r.foes.length))},",
      "replace": "    t:g=>REALMS.every((r,ri)=>Grade.crowned(g.cleared, ri, r.foes.length))},",
      "run": "verify"
    },
    {
      "name": "Paragon needs one realm",
      "file": "index.html",
      "find": "    t:g=>REALMS.every((r,ri)=>Grade.crowned(g.cleared, ri, r.foes.length))}\n];",
      "replace": "    t:g=>REALMS.some((r,ri)=>Grade.crowned(g.cleared, ri, r.foes.length))}\n];",
      "run": "verify"
    },
    {
      "name": "the grade titles go first",
      "file": "index.html",
      "find": "const TITLES = [\n",
      "replace": "const TITLES = [\n  {id:'exemplar0', ic:'🏅', nm:'Exemplar', ds:'Beat 10 foes at S', t:g=>Grade.countS(g.cleared)>=10},\n",
      "run": "verify"
    },
    {
      "name": "Exemplar is never earned",
      "file": "index.html",
      "find": "t:g=>Grade.countS(g.cleared)>=10}",
      "replace": "t:g=>false}",
      "run": "play:gradetitles"
    }
  ]
}