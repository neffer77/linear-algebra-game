{
  "change": "The map points at an upgrade worth buying, and says when it can be bought",
  "mutations": [
    {
      "name": "the next unlock is the cheapest not owned, however weak",
      "file": "index.html",
      "find": "    const all=WEAPONS.filter(x=>x.dmg>bw).concat(ARMORS.filter(x=>x.def>ba))\n",
      "replace": "    const all=WEAPONS.concat(ARMORS)\n",
      "run": "play:map"
    },
    {
      "name": "an affordable unlock is still only a bar",
      "file": "index.html",
      "find": "      ${nx && g.gold>=nx.cost?`<hr><div class=\"node\" id=\"unlockReady\"",
      "replace": "      ${nx && false?`<hr><div class=\"node\" id=\"unlockReady\"",
      "run": "play:map"
    },
    {
      "name": "the ready row does not go to the Smithy",
      "file": "index.html",
      "find": "id=\"unlockReady\" onclick=\"UI.go('s-shop')\"",
      "replace": "id=\"unlockReady\" onclick=\"UI.go('s-map')\"",
      "run": "play:map"
    },
    {
      "name": "the ready row compares against the wrong blade",
      "file": "index.html",
      "find": "hits for ${x.dmg} against your ${w.nm}'s ${w.dmg}",
      "replace": "hits for ${x.dmg} against your ${WEAPONS[1].nm}'s ${WEAPONS[1].dmg}",
      "run": "play:map"
    }
  ]
}
