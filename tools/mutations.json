{
  "change": "Add a Race to infinity mode to the horizon workshop",
  "mutations": [
    {
      "name": "an exponential no longer beats a power",
      "file": "index.html",
      "find": "if(A.b || B.b) return (A.b||0)>(B.b||0);",
      "replace": "if(A.b && B.b) return A.b>B.b;",
      "run": "verify"
    },
    {
      "name": "the power of ln x is ignored",
      "file": "index.html",
      "find": "return A.p!==B.p ? A.p>B.p : A.l>B.l; }",
      "replace": "return A.p>B.p; }",
      "run": "verify"
    },
    {
      "name": "values are rounded to whole numbers",
      "file": "index.html",
      "find": "'≈ '+n.toLocaleString('en-US',{maximumFractionDigits:1})",
      "replace": "'≈ '+n.toLocaleString('en-US',{maximumFractionDigits:0})",
      "run": "verify"
    },
    {
      "name": "places are checked against the order turned round",
      "file": "index.html",
      "find": "this.marks=this.order.map((k,i)=>k===T[i]);",
      "replace": "this.marks=this.order.map((k,i)=>k===T[3-i]);",
      "run": "verify"
    },
    {
      "name": "the check opens with three placed",
      "file": "index.html",
      "find": "ready(){ return this.order.length===4; },",
      "replace": "ready(){ return this.order.length>=3; },",
      "run": "verify"
    },
    {
      "name": "a tap keeps the rings",
      "file": "index.html",
      "find": "this.marks=null; this.touched=true;\n    Horizon.render();",
      "replace": "this.touched=true;\n    Horizon.render();",
      "run": "verify"
    },
    {
      "name": "the pair is worked the wrong way round",
      "file": "index.html",
      "find": "but it grows faster. ${this.why(b,a)}",
      "replace": "but it grows faster. ${this.why(a,b)}",
      "run": "verify"
    },
    {
      "name": "log against log is told as log against power",
      "file": "index.html",
      "find": "A.p===0 && B.p>0 ? 'Every power of ln x",
      "replace": "A.p===0 ? 'Every power of ln x",
      "run": "verify"
    },
    {
      "name": "the pair is worked at x = 10",
      "file": "index.html",
      "find": "for(let e=3;e<=12;e++){ let ok=true;",
      "replace": "for(let e=1;e<=12;e++){ let ok=true;",
      "run": "verify"
    },
    {
      "name": "the leader at x = 10 is told the wrong way",
      "file": "index.html",
      "find": "const nums = this.lg(a,10)>this.lg(b,10)",
      "replace": "const nums = this.lg(a,10)<this.lg(b,10)",
      "run": "verify"
    },
    {
      "name": "an overtake is drawn before the check",
      "file": "index.html",
      "find": "up=this.solved && b<a;",
      "replace": "up=b<a;",
      "run": "verify"
    },
    {
      "name": "Next keeps the order",
      "file": "index.html",
      "find": "this.ri=(this.ri+1)%this.RACES.length; this.order=[];",
      "replace": "this.ri=(this.ri+1)%this.RACES.length;",
      "run": "verify"
    },
    {
      "name": "the race mode is not offered",
      "file": "index.html",
      "find": ",['race','🏁 Race to infinity','See four functions and rank them from slowest to fastest as x grows without end']]",
      "replace": "]",
      "run": "play:hzrace"
    },
    {
      "name": "the race tab shows where does it head",
      "file": "index.html",
      "find": "this.tab==='pick' ? HzPick.html() : HzRace.html();",
      "replace": "HzPick.html();",
      "run": "play:hzrace"
    }
  ]
}