      "replace": "if(Math.abs(this.K-P)<this.K/50) out.push(",
      "run": "verify"
    },
    {
      "name": "rK/4 is told as rK/2",
      "file": "index.html",
      "find": "where growth is fastest: rK/4 = 0.5 × 1000/4 = 125.`",
      "replace": "where growth is fastest: rK/2 = 0.5 × 1000/2 = 250.`",
      "run": "verify"
    },
    {
      "name": "stepping back keeps the step note",
      "file": "index.html",
      "find": "this.t--; this.stepped=false;",
      "replace": "this.t--;",
      "run": "verify"
    },
    {
      "name": "starting over keeps the step note",
      "file": "index.html",
      "find": "again(){ this.t=0; this.stepped=false;",
      "replace": "again(){ this.t=0;",
      "run": "verify"
    },
    {
      "name": "picking a start keeps t",
      "file": "index.html",
      "find": "pick(i){ this.si=i; this.t=0;",
      "replace": "pick(i){ this.si=i;",
      "run": "verify"
    },
    {
      "name": "stepping forward is offered at 20",
      "file": "index.html",
      "find": "can(dt){ const t=this.t+dt; return t>=0 && t<=this.TMAX; },",
      "replace": "can(dt){ const t=this.t+dt; return t>=0 && t<=this.TMAX+1; },",
      "run": "verify"
    },
    {
      "name": "the ceiling is drawn at 900",
      "file": "index.html",
      "find": "y1=\"${f(this.PY(1000))}\" x2=\"${f(this.PX(this.TMAX))}\" y2=\"${f(this.PY(1000))}\"",
      "replace": "y1=\"${f(this.PY(900))}\" x2=\"${f(this.PX(this.TMAX))}\" y2=\"${f(this.PY(900))}\"",
      "run": "verify"
    },
    {
