{
  "change": "Empty items take a small chip · The nudge and the working share a row",
  "mutations": [
    {
      "name": "empty item spells its name",
      "file": "index.html",
      "find": "      : add(k, `${ITEMS[k].ic} ×0`, false, fn, `${nm} ×0, none left`);",
      "replace": "      : add(k, `${ITEMS[k].ic} ${nm} ×0`, false, fn, `${nm} ×0, none left`);",
      "run": "verify"
    },
    {
      "name": "empty item loses its reader name",
      "file": "index.html",
      "find": "      if(name){ d.title=name; d.setAttribute('aria-label', name); }",
      "replace": "      if(name){ d.title=name; }",
      "run": "verify"
    },
    {
      "name": "empty item pressable",
      "file": "index.html",
      "find": "      : add(k, `${ITEMS[k].ic} ×0`, false, fn,",
      "replace": "      : add(k, `${ITEMS[k].ic} ×0`, true, fn,",
      "run": "verify"
    },
    {
      "name": "item in hand always pressable",
      "file": "index.html",
      "find": "      ? add(k, `${ITEMS[k].ic} ${nm} ×${n}`, on, fn)",
      "replace": "      ? add(k, `${ITEMS[k].ic} ${nm} ×${n}`, true, fn)",
      "run": "verify"
    },
    {
      "name": "doors stacked again",
      "file": "index.html",
      "find": "#showwork .wpair{display:grid; grid-template-columns:1fr 1fr; gap:8px;}",
      "replace": "#showwork .wpair{display:grid; grid-template-columns:1fr; gap:8px;}",
      "run": "verify"
    },
    {
      "name": "working paired after a nudge",
      "file": "index.html",
      "find": "    w.innerHTML=offer\n      ? `<div class=\"wpair\">",
      "replace": "    w.innerHTML=(offer||this.nudged)\n      ? `<div class=\"wpair\">",
      "run": "verify"
    },
    {
      "name": "pair loses a price",
      "file": "index.html",
      "find": "'🔎 Show the working<small>the strike, not blood</small>'",
      "replace": "'🔎 Show the working'",
      "run": "verify"
    }
  ]
}