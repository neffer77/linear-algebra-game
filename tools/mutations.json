{
  "change": "The scratch pad sits in the fight's bar",
  "mutations": [
    {
      "name": "corner button back in fights",
      "file": "index.html",
      "find": "const on = Prefs.d.calc!==false && this.relevant() && !fight;",
      "replace": "const on = Prefs.d.calc!==false && this.relevant();",
      "run": "verify"
    },
    {
      "name": "no chip in the bar",
      "file": "index.html",
      "find": "    if(Prefs.d.calc!==false) add('calc', '🧮 Scratch pad', true, ()=>Calc.shown?Calc.close():Calc.open());\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "fight read as training",
      "file": "index.html",
      "find": "return !!on && on.id==='s-battle';\n  },\n  syncButton",
      "replace": "return !!on && on.id==='s-train';\n  },\n  syncButton",
      "run": "verify"
    },
    {
      "name": "chip ignores the setting",
      "file": "index.html",
      "find": "if(Prefs.d.calc!==false) add('calc',",
      "replace": "if(true) add('calc',",
      "run": "verify"
    },
    {
      "name": "chip only opens",
      "file": "index.html",
      "find": "()=>Calc.shown?Calc.close():Calc.open());\n  },",
      "replace": "()=>Calc.open());\n  },",
      "run": "verify"
    },
    {
      "name": "corner button gone from training",
      "file": "index.html",
      "find": "const on = Prefs.d.calc!==false && this.relevant() && !fight;",
      "replace": "const on = Prefs.d.calc!==false && this.relevant() && !fight && false;",
      "run": "verify"
    }
  ]
}