{
  "change": "Add a Sign or size mode to the trig integral workshop",
  "mutations": [
    {
      "name": "the slope of cos loses its minus",
      "file": "index.html",
      "find": "return (G==='sin' ? c*k : -c*k)/a; },",
      "replace": "return (c*k)/a; },",
      "run": "verify"
    },
    {
      "name": "the k inside divides the slope",
      "file": "index.html",
      "find": "return (G==='sin' ? c*k : -c*k)/a; },\n  times(i)",
      "replace": "return (G==='sin' ? c/k : -c/k)/a; },\n  times(i)",
      "run": "verify"
    },
    {
      "name": "right and flipped are swapped",
      "file": "index.html",
      "find": "return Math.abs(r-1)<1e-9 ? 1 : Math.abs(r+1)<1e-9 ? -1 : 0; },",
      "replace": "return Math.abs(r-1)<1e-9 ? -1 : Math.abs(r+1)<1e-9 ? 1 : 0; },",
      "run": "verify"
    },
    {
      "name": "any sine counts as the minus kept",
      "file": "index.html",
      "find": "filter(i=>this.Q(i).g==='sin' && this.truth(i)===1); },",
      "replace": "filter(i=>this.Q(i).g==='sin'); },",
      "run": "verify"
    },
    {
      "name": "a multiplied guess is looked for without its sign",
      "file": "index.html",
      "find": "return c===(g==='cos'?1:-1)*a*k; }); },",
      "replace": "return c===a*k; }); },",
      "run": "verify"
    },
    {
      "name": "x/2 is written as 2x",
      "file": "index.html",
      "find": "k===0.5 ? 'x/2' : `${this.fr(k)}x`; },",
      "replace": "k===0.5 ? '2x' : `${this.fr(k)}x`; },",
      "run": "verify"
    },
    {
      "name": "F′ is drawn before the round is right",
      "file": "index.html",
      "find": "if(this.solved) curves.push(['slope',xs.map(u=>m*a*W(k*u))",
      "replace": "if(true) curves.push(['slope',xs.map(u=>m*a*W(k*u))",
      "run": "verify"
    },
    {
      "name": "F′ is drawn without its k inside",
      "file": "index.html",
      "find": "curves.push(['slope',xs.map(u=>m*a*W(k*u))",
      "replace": "curves.push(['slope',xs.map(u=>m*a*W(u))",
      "run": "verify"
    },
    {
      "name": "a call still moves once the round is right",
      "file": "index.html",
      "find": "if(this.solved || this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    TrigInt.render();",
      "replace": "if(this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    TrigInt.render();",
      "run": "verify"
    }
  ]
}