{
  "change": "Welcome back: the first victory of a sitting pays double experience",
  "mutations": [
    {
      "name": "every victory is a welcome back",
      "file": "index.html",
      "find": "fresh(){ return this.wins===1; },",
      "replace": "fresh(){ return this.wins>=1; },",
      "run": "verify"
    },
    {
      "name": "the welcome back says no experience",
      "file": "index.html",
      "find": "double experience, +${n}.</div>` : ''; },",
      "replace": "double experience.</div>` : ''; },",
      "run": "verify"
    },
    {
      "name": "an arena win can be a welcome back",
      "file": "index.html",
      "find": "const fXp=counted && Sitting.fresh() ? xp : 0;",
      "replace": "const fXp=Sitting.fresh() ? xp : 0;",
      "run": "verify"
    },
    {
      "name": "the card says no welcome back",
      "file": "index.html",
      "find": "          ${Sitting.freshLine(fXp)}\n",
      "replace": "",
      "run": "play:fresh"
    },
    {
      "name": "the welcome back is not gained",
      "file": "index.html",
      "find": "const ups=Game.gainXp(xp+fXp);",
      "replace": "const ups=Game.gainXp(xp);",
      "run": "play:fresh"
    },
    {
      "name": "the card leaves the welcome back out of its count",
      "file": "index.html",
      "find": "countUp(document.getElementById('rXp'),   xp+fXp,   900);",
      "replace": "countUp(document.getElementById('rXp'),   xp,   900);",
      "run": "play:fresh"
    },
    {
      "name": "the welcome back pays a third more",
      "file": "index.html",
      "find": "const fXp=counted && Sitting.fresh() ? xp : 0;",
      "replace": "const fXp=counted && Sitting.fresh() ? Math.round(xp/3) : 0;",
      "run": "play:fresh"
    },
    {
      "name": "the second victory is the welcome back",
      "file": "index.html",
      "find": "fresh(){ return this.wins===1; },",
      "replace": "fresh(){ return this.wins===2; },",
      "run": "play:fresh"
    }
  ]
}