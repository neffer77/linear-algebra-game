{
  "change": "A flourish: eight right in a row can be spent for one blow three times as hard",
  "mutations": [
    {
      "name": "a flourish from seven in a row",
      "file": "index.html",
      "find": "  AT: 8, MUL: 3,",
      "replace": "  AT: 7, MUL: 3,",
      "run": "verify"
    },
    {
      "name": "a flourish lands twice as hard",
      "file": "index.html",
      "find": "  AT: 8, MUL: 3,",
      "replace": "  AT: 8, MUL: 2,",
      "run": "verify"
    },
    {
      "name": "a flourish in the arena too",
      "file": "index.html",
      "find": "B.mode==='campaign' && !B.over && !B.answered && !B.flourish && (B.combo||0)>=this.AT",
      "replace": "!B.over && !B.answered && !B.flourish && (B.combo||0)>=this.AT",
      "run": "verify"
    },
    {
      "name": "a flourish after the answer",
      "file": "index.html",
      "find": "B.mode==='campaign' && !B.over && !B.answered && !B.flourish",
      "replace": "B.mode==='campaign' && !B.over && !B.flourish",
      "run": "verify"
    },
    {
      "name": "a flourish keeps the streak",
      "file": "index.html",
      "find": "    B.flourish=true; B.combo=0;\n",
      "replace": "    B.flourish=true;\n",
      "run": "verify"
    },
    {
      "name": "a flourish is never spent",
      "file": "index.html",
      "find": "    if(!B || !B.flourish) return false;\n    B.flourish=false;\n",
      "replace": "    if(!B || !B.flourish) return false;\n",
      "run": "verify"
    },
    {
      "name": "a miss keeps the flourish",
      "file": "index.html",
      "find": "    if(!ok) this.flourish=false;",
      "replace": "    if(!ok) {}",
      "run": "verify"
    },
    {
      "name": "a fight starts with the last flourish",
      "file": "index.html",
      "find": "    this.flourish=false;   // nor any flourish\n",
      "replace": "\n",
      "run": "verify"
    },
    {
      "name": "the blow ignores the flourish",
      "file": "index.html",
      "find": "* Flourish.bonus(this) * Phase.bonus(this)",
      "replace": "* Phase.bonus(this)",
      "run": "verify"
    },
    {
      "name": "in play, the bar offers no flourish",
      "file": "index.html",
      "find": "if(Flourish.can(this) || this.flourish) add('flourish'",
      "replace": "if(false) add('flourish'",
      "run": "play:flourish"
    },
    {
      "name": "in play, the bar is not drawn again",
      "file": "index.html",
      "find": "B.updateBars(); if(B.renderPowers) B.renderPowers();",
      "replace": "B.updateBars();",
      "run": "play:flourish"
    },
    {
      "name": "in play, a flourish is spent at once",
      "file": "index.html",
      "find": "  bonus(B){ return B && B.flourish ? this.MUL : 1; },",
      "replace": "  bonus(B){ return 1; },",
      "run": "play:flourish"
    }
  ]
}