{
  "change": "The logistic workshop: step a population toward its ceiling and watch the rate rise and fall.",
  "mutations": [
    {
      "name": "r is 0.4",
      "file": "index.html",
      "find": "r:0.5, K:1000, TMAX:20,",
      "replace": "r:0.4, K:1000, TMAX:20,",
      "run": "verify"
    },
    {
      "name": "the steps run to 21",
      "file": "index.html",
      "find": "r:0.5, K:1000, TMAX:20,",
      "replace": "r:0.5, K:1000, TMAX:21,",
      "run": "verify"
    },
    {
      "name": "starting small is at 25",
      "file": "index.html",
      "find": "P0:20, Y:[0,1100],",
      "replace": "P0:25, Y:[0,1100],",
      "run": "verify"
    },
    {
      "name": "A is the wrong way up",
      "file": "index.html",
      "find": "A(){ const P0=this.set().P0; return (this.K-P0)/P0; },",
      "replace": "A(){ const P0=this.set().P0; return P0/(this.K-P0); },",
      "run": "verify"
    },
    {
      "name": "P uses e^(+rt)",
      "file": "index.html",
      "find": "return this.K/(1+this.A()*Math.exp(-this.r*t));",
      "replace": "return this.K/(1+this.A()*Math.exp(this.r*t));",
      "run": "verify"
    },
    {
      "name": "the rate has no ceiling",
      "file": "index.html",
      "find": "return this.r*P*(1-P/this.K); },",
      "replace": "return this.r*P; },",
      "run": "verify"
    },
    {
      "name": "the rate uses P/K",
      "file": "index.html",
      "find": "return this.r*P*(1-P/this.K); },",
      "replace": "return this.r*P*(P/this.K); },",
      "run": "verify"
    },
    {
      "name": "starting above, A is told as 0.6",
      "file": "index.html",
      "find": "A = (1000 − 1600)/1600 = −0.375, so P(t) = 1000/(1 − 0.375·e^(−0.5t)).",
      "replace": "A = (1000 − 1600)/1600 = −0.6, so P(t) = 1000/(1 − 0.6·e^(−0.5t)).",
      "run": "verify"
    },
    {
      "name": "e is told to two places",
      "file": "index.html",
      "find": "sig(v){ return String(+v.toPrecision(4)); },",
      "replace": "sig(v){ return String(+v.toFixed(2)); },",
      "run": "verify"
    },
    {
      "name": "P is told to whole numbers",
      "file": "index.html",
      "find": "so P = 1000/(1 ${sg} ${Aw}${this.sig(e)}) ${this.is(P,1)}.`",
      "replace": "so P = 1000/(1 ${sg} ${Aw}${this.sig(e)}) ${this.is(P,0)}.`",
      "run": "verify"
    },
    {
      "name": "the room left is told as P/K",
      "file": "index.html",
      "find": "const S=this.set(), t=this.t, P=this.P(), room=1-P/this.K,",
      "replace": "const S=this.set(), t=this.t, P=this.P(), room=P/this.K,",
      "run": "verify"
    },
    {
      "name": "a shrinking P is told as growing",
      "file": "index.html",
      "find": "(R>0 ? 'P is growing.' : 'below 0, so P is shrinking.'));",
      "replace": "(R>-1 ? 'P is growing.' : 'below 0, so P is shrinking.'));",
      "run": "verify"
    },
    {
      "name": "the step's growth is turned over",
