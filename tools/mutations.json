{
  "change": "The Arc Length Workshop: lay straight chords along a curve, measure each by Pythagoras, and watch the total close in on ∫√(1 + f′²) dx.",
  "mutations": [
    {
      "name": "the line's slope is 4/3",
      "file": "index.html",
      "find": "f:x=>0.75*x, T:5,",
      "replace": "f:x=>x*4/3, T:5,",
      "run": "verify"
    },
    {
      "name": "the cubic's second term is 1/x",
      "file": "index.html",
      "find": "f:x=>x**3/6+1/(2*x),",
      "replace": "f:x=>x**3/6+1/x,",
      "run": "verify"
    },
    {
      "name": "the cubic's true length is 17/11",
      "file": "index.html",
      "find": "T:17/12, Ts:'17/12',",
      "replace": "T:17/11, Ts:'17/12',",
      "run": "verify"
    },
    {
      "name": "the circle's true length is π",
      "file": "index.html",
      "find": "T:Math.PI/2, Ts:'π/2',",
      "replace": "T:Math.PI, Ts:'π/2',",
      "run": "verify"
    },
    {
      "name": "the circle runs to 0.9",
      "file": "index.html",
      "find": "a:0, b:1, f:x=>Math.sqrt(Math.max(0,1-x*x)),",
      "replace": "a:0, b:0.9, f:x=>Math.sqrt(Math.max(0,1-x*x)),",
      "run": "verify"
    },
    {
      "name": "the cubic's opening forgets the square",
      "file": "index.html",
      "find": "so the true length is ∫₁² (x²/2 + 1/(2x²)) dx = 17/12",
      "replace": "so the true length is ∫₁² √(x²/2 + 1/(2x²)) dx = 17/12",
      "run": "verify"
    },
    {
