{
 "change": "The Undo Workshop: the matrix that puts a move back",
 "mutations": [
  {
   "name": "B's bottom row uses its top row",
   "file": "index.html",
   "find": "out.push(`B sends A${nm} = ${this.vec(v)} to ⟨${neg(B[0][0])}·${this.amt(v[0])} + ${this.amt(B[0][1])}·${this.amt(v[1])}, ${neg(B[1][0])}",
   "replace": "out.push(`B sends A${nm} = ${this.vec(v)} to ⟨${neg(B[0][0])}·${this.amt(v[0])} + ${this.amt(B[0][1])}·${this.amt(v[1])}, ${neg(B[0][0])}",
   "run": "verify"
  },
  {
   "name": "B is applied by columns instead of rows",
   "file": "index.html",
   "find": "end(j){ return this.app(this.B, this.col(this.A(), j)); },",
   "replace": "end(j){ const [[a,b],[c,d]]=this.B; return this.app([[a,c],[b,d]], this.col(this.A(), j)); },",
   "run": "verify"
  },
  {
   "name": "A's arrows are read from its rows",
   "file": "index.html",
   "find": "out.push(`A is ${this.MATS[this.mi].is}: it sends î to ${this.vec(this.col(A,0))} and ĵ to ${this.vec(this.col(A,1))}.`);",
   "replace": "out.push(`A is ${this.MATS[this.mi].is}: it sends î to ${this.vec(A[0])} and ĵ to ${this.vec(A[1])}.`);",
   "run": "verify"
  },
  {
   "name": "a negative factor is not bracketed",
   "file": "index.html",
   "find": "amt(n){ return n<0 ? `(${neg(n)})` : neg(n); },\n  rows(M)",
   "replace": "amt(n){ return neg(n); },\n  rows(M)",
   "run": "verify"
  },
  {
   "name": "home counts one arrow only",
   "file": "index.html",
   "find": "undone(){ return this.home(0) && this.home(1); },",
   "replace": "undone(){ return this.home(0); },",
   "run": "verify"
  },
  {
   "name": "the squash names an arrow it does not crush",
   "file": "index.html",
   "find": "const z=[A[0][1], -A[0][0]];",
   "replace": "const z=[A[0][0], -A[0][1]];",
   "run": "verify"
  },
  {
   "name": "the flip is not called its own undo",
   "file": "index.html",
   "find": "(A.every((r,i)=>r.every((x,j)=>x===B[i][j])) ? ' A is its own undo",
   "replace": "(A.every((r,i)=>r.every((x,j)=>x===B[j][i]&&i!==j)) ? ' A is its own undo",
   "run": "verify"
  },
  {
   "name": "a new A keeps the old B",
   "file": "index.html",
   "find": "pick(i){ this.mi=i; this.B=[[1,0],[0,1]]; this.moved=false;",
   "replace": "pick(i){ this.mi=i; this.moved=false;",
   "run": "play:undo"
  },
  {
   "name": "the steppers stop at ±1",
   "file": "index.html",
   "find": "LO:-2, HI:2,\n  mi:0, B:[[1,0],[0,1]]",
   "replace": "LO:-1, HI:1,\n  mi:0, B:[[1,0],[0,1]]",
   "run": "play:undo"
  },
  {
   "name": "the half goal needs both arrows away",
   "file": "index.html",
   "find": "ok:U=>U.moved && U.home(0)!==U.home(1)}",
   "replace": "ok:U=>U.moved && !U.home(0) && !U.home(1)}",
   "run": "play:undo"
  },
  {
   "name": "picking the squash counts as trying",
   "file": "index.html",
   "find": "ok:U=>U.mi===4 && U.moved}",
   "replace": "ok:U=>U.mi===4}",
   "run": "play:undo"
  },
  {
   "name": "B's numbers lose their names",
   "file": "index.html",
   "find": "<b aria-label=\"B's ${nm} number: ${neg(v)}\">",
   "replace": "<b>",
   "run": "play:undo"
  },
  {
   "name": "the caption drops the rings",
   "file": "index.html",
   "find": "Blue and green: where B then sends them. The rings are home.'",
   "replace": "Blue and green: where B then sends them.'",
   "run": "play:undo"
  },
  {
   "name": "a found goal gives no toast",
   "file": "index.html",
   "find": "else { UI.toast('✓ '+fresh.map(g=>g.toast).join(' · ')); Sfx.good(); }\n    }\n  }\n};\n\n/* ============ ORDER MATTERS",
   "replace": "else { Sfx.good(); }\n    }\n  }\n};\n\n/* ============ ORDER MATTERS",
   "run": "play:undo"
  }
 ]
}