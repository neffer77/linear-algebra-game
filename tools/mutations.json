{
  "change": "Nameplate: a long foe nameplate wraps in its own half of the bars and never pushes the foe's health off a phone's screen",
  "mutations": [
    {
      "name": "the health pushed off the screen",
      "file": "index.html",
      "find": ".bars>.bar{min-width:0}\n",
      "replace": "\n",
      "run": "verify"
    },
    {
      "name": "a long name never wraps",
      "file": "index.html",
      "find": "#foeName{min-width:0; overflow-wrap:anywhere}\n",
      "replace": "\n",
      "run": "verify"
    },
    {
      "name": "the health pushed off the screen, seen in play",
      "file": "index.html",
      "find": ".bars>.bar{min-width:0}\n.bar .lbl{gap:6px}\n#foeName{min-width:0; overflow-wrap:anywhere}\n#pHpTxt,#eHpTxt{flex:none; white-space:nowrap}\n",
      "replace": "\n",
      "run": "play:nameplate"
    },
    {
      "name": "the health text wraps, seen in play",
      "file": "index.html",
      "find": "#pHpTxt,#eHpTxt{flex:none; white-space:nowrap}\n",
      "replace": "\n",
      "run": "play:nameplate"
    }
  ]
}