{
 "change": "The workshop index: every workshop one tap from the top of the Tome",
 "mutations": [
  {
   "name": "a workshop is filed under its last topic",
   "file": "index.html",
   "find": "      w.at=pos[w.topics[0]];",
   "replace": "      w.at=pos[w.topics[w.topics.length-1]];",
   "run": "verify"
