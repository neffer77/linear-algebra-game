   "run": "verify"
  },
  {
   "name": "solid takes more than it should",
   "file": "index.html",
   "find": "seen.every(k=>Mastery.eff(k)>=this.SOLID)",
   "replace": "seen.every(k=>Mastery.eff(k)>this.SOLID)",
   "run": "verify"
  },
  {
   "name": "weak needs every topic low",
