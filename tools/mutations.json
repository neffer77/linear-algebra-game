{
  "change": "The daily's mastery recap is headed as a run",
  "mutations": [
    {
      "name": "the daily recap is headed as a fight again",
      "file": "index.html",
      "find": "What this ${this.mode==='daily'?'run':'fight'} taught",
      "replace": "What this fight taught",
      "run": "play:map"
    },
    {
      "name": "every recap is headed as a run",
      "file": "index.html",
      "find": "What this ${this.mode==='daily'?'run':'fight'} taught",
      "replace": "What this run taught",
      "run": "play:lesson"
    }
  ]
}