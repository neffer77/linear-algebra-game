      "file": "index.html",
      "find": "      if(A11y.tabbed && t && t!==go && t.nodeType===1 && !t.disabled &&\n",
      "replace": "      if(t && t!==go && t.nodeType===1 && !t.disabled &&\n",
      "run": "play:a11y"
    },
