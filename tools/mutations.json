{
  "change": "Beaten fights take one short row: the fight still to come keeps its card and sits near the realm's heading",
  "mutations": [
    {
      "name": "a won fight keeps its full card",
      "file": "index.html",
      "find": "        if(done){\n",
      "replace": "        if(false){\n",
      "run": "verify"
    },
    {
      "name": "a short row drops its best grade",
      "file": "index.html",
      "find": "<div class=\"nm\">${f.nm} ${Grade.tag(g.cleared[ri+':'+fi])||'<span class=\"tag g\">✓</span>'}",
      "replace": "<div class=\"nm\">${f.nm} <span class=\"tag g\">✓</span>",
      "run": "verify"
    },
    {
      "name": "a short row still reckons",
      "file": "index.html",
      "find": "          <div class=\"sgold\">🪙 ${f.gold}</div>\n",
      "replace": "          <div class=\"sgold\">🪙 ${f.gold}</div>${Reckon.line(f, g)}\n",
      "run": "verify"
    },
    {
      "name": "a short row no longer fights",
      "file": "index.html",
      "find": "<div class=\"node done slim ${open?'':'locked'}\" onclick=\"Battle.begin(${ri},${fi})\">",
      "replace": "<div class=\"node done slim ${open?'':'locked'}\">",
      "run": "verify"
    },
    {
      "name": "a won fight keeps its full card, seen in play",
      "file": "index.html",
      "find": "        if(done){\n",
      "replace": "        if(false){\n",
      "run": "play:slimrows"
    },
    {
      "name": "a short row runs tall, seen in play",
      "file": "index.html",
      "find": ".node.slim{padding:6px 10px; margin:5px 0; gap:8px;}",
      "replace": ".node.slim{padding:26px 10px; margin:5px 0; gap:8px;}",
      "run": "play:slimrows"
    },
    {
      "name": "a short row no longer fights, seen in play",
      "file": "index.html",
      "find": "<div class=\"node done slim ${open?'':'locked'}\" onclick=\"Battle.begin(${ri},${fi})\">",
      "replace": "<div class=\"node done slim ${open?'':'locked'}\">",
      "run": "play:slimrows"
    }
  ]
}