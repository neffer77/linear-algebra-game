{
  "change": "Add a Does du fit mode to the swap workshop",
  "mutations": [
    {
      "name": "the power of x is not checked",
      "file": "index.html",
      "find": "truth(i){ const {c,p,a,m}=this.Q(i); return p!==m-1 ? -1 : c===m*a ? 1 : 0; },",
      "replace": "truth(i){ const {c,p,a,m}=this.Q(i); return c===m*a ? 1 : 0; },",
      "run": "verify"
    },
    {
      "name": "du forgets the m",
      "file": "index.html",
      "find": "c===m*a ? 1 : 0; },",
      "replace": "c===a ? 1 : 0; },",
      "run": "verify"
    },
    {
      "name": "the number in front is turned upside down",
      "file": "index.html",
      "find": "k(i){ const {c,a,m}=this.Q(i); return this.fr(c,m*a); },",
      "replace": "k(i){ const {c,a,m}=this.Q(i); return this.fr(m*a,c); },",
      "run": "verify"
    },
    {
      "name": "du drops its minus",
      "file": "index.html",
      "find": "return `du = ${m*a===1 ? '' : m*a===-1 ? '−' : neg(m*a)}${x} dx`; },",
      "replace": "return `du = ${Math.abs(m*a)===1 ? '' : neg(Math.abs(m*a))}${x} dx`; },",
      "run": "verify"
    },
    {
      "name": "the leftover power is off by one",
      "file": "index.html",
      "find": "`${this.xp(this.Q(i).p-this.Q(i).m+1)} left over`; },",
      "replace": "`${this.xp(this.Q(i).p-this.Q(i).m)} left over`; },",
      "run": "verify"
    },
    {
      "name": "du is written before the round is right",
      "file": "index.html",
      "find": "if(this.solved){ const t=this.truth(i);\n        out+=`<text data-k=\"du\"",
      "replace": "{ const t=this.truth(i);\n        out+=`<text data-k=\"du\"",
      "run": "verify"
    },
    {
      "name": "a minus in u is not looked for",
      "file": "index.html",
      "find": "signs(){ return [0,1,2,3].filter(i=>this.Q(i).a<0 && this.truth(i)>=0); },",
      "replace": "signs(){ return [0,1,2,3].filter(i=>this.Q(i).b<0 && this.truth(i)>=0); },",
      "run": "verify"
    },
    {
      "name": "a call still moves once the round is right",
      "file": "index.html",
      "find": "if(this.solved || this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    Swap.render();",
      "replace": "if(this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    Swap.render();",
      "run": "verify"
    }
  ]
}