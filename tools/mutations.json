{
 "change": "Seen before it is bought: the Smithy shows every blade and armour as the fight will draw it",
 "mutations": [
  {
   "name": "the Smithy shows the old icons",
   "file": "index.html",
   "find": "        <div class=\"ic\">${Arms.bladeSvg(w.id)||w.ic}</div>",
   "replace": "        <div class=\"ic\">${w.ic}</div>",
   "run": "verify"
  },
  {
   "name": "every blade the same length at the Smithy",
   "file": "index.html",
   "find": "  len(id){ const b=this.BLADES[id]; return b ? Math.round(b.len*0.4) : 0; },",
   "replace": "  len(id){ const b=this.BLADES[id]; return b ? 24 : 0; },",
   "run": "verify"
  },
  {
   "name": "the blade's steel not shown",
   "file": "index.html",
   "find": "<stop offset=\".5\" stop-color=\"${b.mid}\"/>",
   "replace": "<stop offset=\".5\" stop-color=\"#dfe8f5\"/>",
   "run": "verify"
  },
  {
   "name": "the plate's shadow not shown",
   "file": "index.html",
   "find": "fill=\"${p.skin}\" stroke=\"${p.dark}\" stroke-width=\"2\"/>",
   "replace": "fill=\"${p.skin}\" stroke=\"#8b97a8\" stroke-width=\"2\"/>",
   "run": "verify"
  },
  {
   "name": "the Smithy shows the old armour icons, seen in play",
   "file": "index.html",
   "find": "        <div class=\"ic\">${Arms.plateSvg(a.id)||a.ic}</div>",
   "replace": "        <div class=\"ic\">${a.ic}</div>",
   "run": "play:arms"
  }
 ]
}
