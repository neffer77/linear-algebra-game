{
  "change": "Titles show the way: each locked title says how far off it is, and the nearest is marked",
  "mutations": [
    {"name": "the count overruns its title", "file": "index.html", "find": "    const st=g.stats||{}, n=(v,of)=>({n:Math.max(0,Math.min(of,Math.floor(v||0))), of});", "replace": "    const st=g.stats||{}, n=(v,of)=>({n:Math.max(0,Math.floor(v||0)), of});", "run": "verify"},
    {"name": "Knight-Errant counts to the wrong mark", "file": "index.html", "find": "      case 'errant':   return n(st.correct,250);", "replace": "      case 'errant':   return n(st.correct,200);", "run": "verify"},
    {"name": "the streak title reads the wrong stat", "file": "index.html", "find": "      case 'form':     return n(st.best,15);", "replace": "      case 'form':     return n(st.correct,15);", "run": "verify"},
    {"name": "a finished count marked as next", "file": "index.html", "find": "      const x=w.n/w.of; if(x>f&&x<1){ f=x; best=t.id; }", "replace": "      const x=w.n/w.of; if(x>f){ f=x; best=t.id; }", "run": "verify"},
    {"name": "an earned title still counted", "file": "index.html", "find": "    const got=g&&g.titles&&g.titles[t.id], w=got?null:this.of(t,g), near=!got&&this.near(g)===t.id;", "replace": "    const got=g&&g.titles&&g.titles[t.id], w=this.of(t,g), near=!got&&this.near(g)===t.id;", "run": "verify"},
    {"name": "the counts not shown, seen in play", "file": "index.html", "find": "${w?`<span class=\"tway\">${this.text(w)}</span>`:''}", "replace": "${''}", "run": "play:titleway"},
    {"name": "the nearest not marked, seen in play", "file": "index.html", "find": "${near?' near':''}\" data-title", "replace": "\" data-title", "run": "play:titleway"}
  ]
}
