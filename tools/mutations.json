{
  "change": "Revenge: the foe that felled you holds your lost gold until you beat it",
  "mutations": [
    {
      "name": "falls to one foe do not add up",
      "file": "index.html",
      "find": "this.owed[key]=(this.owed[key]||0)+gold;",
      "replace": "this.owed[key]=gold;",
      "run": "verify"
    },
    {
      "name": "a fall that lost nothing holds something",
      "file": "index.html",
      "find": "mark(key, gold){ if(gold>0) this.owed",
      "replace": "mark(key, gold){ if(gold>=0) this.owed",
      "run": "verify"
    },
    {
      "name": "a win pays back but does not clear it",
      "file": "index.html",
      "find": "const n=this.owed[key]||0; delete this.owed[key]; return n;",
      "replace": "const n=this.owed[key]||0; return n;",
      "run": "verify"
    },
    {
      "name": "a win pays back nothing",
      "file": "index.html",
      "find": "const n=this.owed[key]||0; delete this.owed[key]; return n;",
      "replace": "delete this.owed[key]; return 0;",
      "run": "verify"
    },
    {
      "name": "a fall holds nothing",
      "file": "index.html",
      "find": "const held=this.mode==='campaign' ? Revenge.mark(this.ri+':'+this.fi, lost) : 0;",
      "replace": "const held=0;",
      "run": "verify"
    },
    {
      "name": "the gold won back is not counted on the card",
      "file": "index.html",
      "find": "gold+sGold+oGold+rGold, 900);",
      "replace": "gold+sGold+oGold, 900);",
      "run": "verify"
    },
    {
      "name": "the map does not mark the foe",
      "file": "index.html",
      "find": "${Revenge.tag(Revenge.of(ri+':'+fi))}",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the gold is won back but not paid",
      "file": "index.html",
      "find": "    const rGold=this.mode==='campaign' ? Revenge.claim(key) : 0;\n    g.gold+=rGold;",
      "replace": "    const rGold=this.mode==='campaign' ? Revenge.claim(key) : 0;",
      "run": "play:revenge"
    },
    {
      "name": "any foe pays back what another holds",
      "file": "index.html",
      "find": "const rGold=this.mode==='campaign' ? Revenge.claim(key) : 0;",
      "replace": "const rGold=this.mode==='campaign' ? Revenge.claim(Object.keys(Revenge.owed)[0]) : 0;",
      "run": "play:revenge"
    },
    {
      "name": "the map marks every foe once any holds gold",
      "file": "index.html",
      "find": "${Revenge.tag(Revenge.of(ri+':'+fi))}",
      "replace": "${Revenge.tag(Object.values(Revenge.owed)[0]||0)}",
      "run": "play:revenge"
    }
  ]
}