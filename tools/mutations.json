{
  "change": "Add a Too low or too high mode to the Gram–Schmidt workshop",
  "mutations": [
    {
      "name": "a square pair is called too low",
      "file": "index.html",
      "find": "truth(i){ return Math.sign(this.wu(i)); },",
      "replace": "truth(i){ return Math.sign(this.wu(i)+0.5); },",
      "run": "verify"
    },
    {
      "name": "each copy is taken to cost 1",
      "file": "index.html",
      "find": "wu(i){ return this.dp(i)-this.c(i)*this.nn(i); },",
      "replace": "wu(i){ return this.dp(i)-this.c(i); },",
      "run": "verify"
    },
    {
      "name": "u₂ · u₁ drops its second term",
      "file": "index.html",
      "find": "dp(i){ const [u,v]=this.R()[i]; return this.dot(v,u); },",
      "replace": "dp(i){ const [u,v]=this.R()[i]; return v[0]*u[0]; },",
      "run": "verify"
    },
    {
      "name": "a costly copy is taken as one too low",
      "file": "index.html",
      "find": "costs(){ return [0,1,2,3].filter(i=>this.truth(i)===-1 && this.c(i)<this.dp(i)); },",
      "replace": "costs(){ return [0,1,2,3].filter(i=>this.truth(i)===1 && this.c(i)<this.dp(i)); },",
      "run": "verify"
    },
    {
      "name": "w is drawn before the round is right",
      "file": "index.html",
      "find": "if(this.solved){ const cu=[c*u[0],c*u[1]], w=this.w(i);",
      "replace": "if(true){ const cu=[c*u[0],c*u[1]], w=this.w(i);",
      "run": "verify"
    },
    {
      "name": "w is drawn as u₂ + c·u₁",
      "file": "index.html",
      "find": "w(i){ const [u,v,c]=this.R()[i]; return [v[0]-c*u[0], v[1]-c*u[1]]; },",
      "replace": "w(i){ const [u,v,c]=this.R()[i]; return [v[0]+c*u[0], v[1]+c*u[1]]; },",
      "run": "verify"
    },
    {
      "name": "a backward shadow's c keeps the wrong sign",
      "file": "index.html",
      "find": "best(i){ let p=this.dp(i), q=this.nn(i);",
      "replace": "best(i){ let p=Math.abs(this.dp(i)), q=this.nn(i);",
      "run": "verify"
    },
    {
      "name": "a call still moves once the round is right",
      "file": "index.html",
      "find": "if(this.solved || this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    Gram.render();",
      "replace": "if(this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    Gram.render();",
      "run": "verify"
    }
  ]
}