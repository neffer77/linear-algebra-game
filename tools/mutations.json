{
  "change": "A victory pose: a won fight lifts the knight's blade overhead and hops them for joy",
  "mutations": [
    {
      "name": "the stars at the feet",
      "file": "index.html",
      "find": "  head(s){ return { x: this.HEAD*s*Math.sin(this.FALL), y: -this.HEAD*s*Math.cos(this.FALL) }; },",
      "replace": "  head(s){ return { x: 0, y: 0 }; },",
      "run": "verify"
    },
    {
      "name": "the stars where the head stood",
      "file": "index.html",
      "find": "  head(s){ return { x: this.HEAD*s*Math.sin(this.FALL), y: -this.HEAD*s*Math.cos(this.FALL) }; },",
      "replace": "  head(s){ return { x: 0, y: -this.HEAD*s }; },",
      "run": "verify"
    },
    {
      "name": "the stars stand still",
      "file": "index.html",
      "find": "      const a=(t||0)*this.SPIN + i*Math.PI*2/this.N;",
      "replace": "      const a=i*Math.PI*2/this.N;",
      "run": "verify"
    },
    {
      "name": "two stars",
