{
 "change": "A fight's summary offers the workshop that fits each fall",
 "mutations": [
  {
   "name": "L'Hôpital's rule points to the limit workshop",
   "file": "index.html",
   "find": "    Limit:   [\"🌫️ Limit Workshop\", ['limRational']],\n    Hopital: [\"🔬 L'Hôpital Workshop\", ['lhopital']],",
   "replace": "    Limit:   [\"🌫️ Limit Workshop\", ['limRational','lhopital']],\n    Hopital: [\"🔬 L'Hôpital Workshop\", []],",
   "run": "play:handson"
  },
  {
   "name": "a workshop's name drifts from the Tome's",
   "file": "index.html",
   "find": "    Chain:   [\"⛓️ Chain Rule Workshop\", ['chainRule']],",
   "replace": "    Chain:   [\"⛓️ Chain Workshop\", ['chainRule']],",
   "run": "verify"
  },
  {
   "name": "a topic's key is misspelt",
   "file": "index.html",
   "find": "    Optim:   [\"🏗️ Biggest Build Workshop\", ['optimisation','critical']],",
   "replace": "    Optim:   [\"🏗️ Biggest Build Workshop\", ['optimization','critical']],",
   "run": "verify"
  },
  {
   "name": "a topic that rose is offered a workshop",
   "file": "index.html",
   "find": "rows.filter(x=>x.d.to<x.d.from && WORKSHOP_FOR[x.k])",
   "replace": "rows.filter(x=>x.d.to!==x.d.from && WORKSHOP_FOR[x.k])",
   "run": "play:handson"
  },
  {
   "name": "any number of workshops is offered",
   "file": "index.html",
   "find": "if(!seen.has(w.mod) && pick.length<2){",
   "replace": "if(!seen.has(w.mod) && pick.length<9){",
   "run": "play:handson"
  },
  {
   "name": "one workshop is offered twice",
   "file": "index.html",
   "find": "if(!seen.has(w.mod) && pick.length<2){",
   "replace": "if(pick.length<2){",
   "run": "play:handson"
  },
  {
   "name": "the smallest fall comes first",
   "file": "index.html",
   "find": ".sort((a,b)=>(a.d.to-a.d.from)-(b.d.to-b.d.from))",
   "replace": ".sort((a,b)=>(b.d.to-b.d.from)-(a.d.to-a.d.from))",
   "run": "play:handson"
  },
  {
   "name": "the heading shows with nothing under it",
   "file": "index.html",
   "find": "    if(!pick.length) return '';\n    return `<div id=\"handsOn\"",
   "replace": "    return `<div id=\"handsOn\"",
   "run": "play:handson"
  },
  {
   "name": "the button forgets the topic",
   "file": "index.html",
   "find": "${w.name}, for ${TOPIC_LABEL[k]}</button>",
   "replace": "${w.name}</button>",
   "run": "play:handson"
  }
 ]
}