{
  "change": "The daily's counter names the riddle on screen",
  "mutations": [
    {
      "name": "the counter is not redrawn as the run moves on",
      "file": "index.html",
      "find": "this.nextQuestion(); this.updateBars(); return;",
      "replace": "this.nextQuestion(); return;",
      "run": "play"
    },
    {
      "name": "the counter counts the riddles answered instead",
      "file": "index.html",
      "find": "`🗡️ ${Math.min(Daily.n+1,Daily.LEN)}/${Daily.LEN}",
      "replace": "`🗡️ ${Daily.n}/${Daily.LEN}",
      "run": "play"
    },
    {
      "name": "the counter can run past the last riddle",
      "file": "index.html",
      "find": "`🗡️ ${Math.min(Daily.n+1,Daily.LEN)}/${Daily.LEN}",
      "replace": "`🗡️ ${Daily.n+2}/${Daily.LEN}",
      "run": "play"
    }
  ]
}