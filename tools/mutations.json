{
  "change": "One row of ways home",
  "mutations": [
    {
      "name": "map back as a full button",
      "file": "index.html",
      "find": "${nx?'':`<button class=\"btn gold\" onclick=\"UI.go('s-map')\">🗺️ Onward</button>`}",
      "replace": "<button class=\"btn${nx?'':' gold'}\" onclick=\"UI.go('s-map')\">🗺️ ${nx?'To the map':'Onward'}</button>",
      "run": "verify"
    },
    {
      "name": "row of three always",
      "file": "index.html",
      "find": "    const map = nx ? `<button",
      "replace": "    const map = true ? `<button",
      "run": "verify"
    },
    {
      "name": "row out of order",
      "file": "index.html",
      "find": "id=\"winRow\">${map}<button class=\"btn\" id=\"againBtn\" onclick=\"${again}\"${aw}</button>",
      "replace": "id=\"winRow\"><button class=\"btn\" id=\"againBtn\" onclick=\"${again}\"${aw}</button>${map}",
      "run": "verify"
    },
    {
      "name": "row buttons wrap",
      "file": "index.html",
      "find": "font-size:15px;white-space:nowrap;text-align:center}",
      "replace": "font-size:15px;text-align:center}",
      "run": "verify"
    },
    {
      "name": "row before the offers",
      "file": "index.html",
      "find": "        ${Rival.offer(this)}\n        ${Heroic.button(this)}\n        ${WinRow.html(this, nx)}`;",
      "replace": "        ${WinRow.html(this, nx)}\n        ${Rival.offer(this)}\n        ${Heroic.button(this)}`;",
      "run": "verify"
    }
  ]
}