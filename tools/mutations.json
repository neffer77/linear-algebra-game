{
  "change": "Today's quarry: one beaten foe a day pays its full gold again",
  "mutations": [
    {
      "name": "a boss can be the quarry",
      "file": "index.html",
      "find": "if(f.boss || !cleared[key]) return;",
      "replace": "if(!cleared[key]) return;",
      "run": "verify"
    },
    {
      "name": "an unbeaten foe can be the quarry",
      "file": "index.html",
      "find": "if(f.boss || !cleared[key]) return;",
      "replace": "if(f.boss) return;",
      "run": "verify"
    },
    {
      "name": "the first beaten foe is the quarry",
      "file": "index.html",
      "find": "if(d<low){ low=d; best=key; }",
      "replace": "if(best===null){ low=d; best=key; }",
      "run": "verify"
    },
    {
      "name": "the quarry ignores the day",
      "file": "index.html",
      "find": "for(const c of 'quarry '+day+' '+key)",
      "replace": "for(const c of 'quarry '+key)",
      "run": "verify"
    },
    {
      "name": "the quarry is read after the win",
      "file": "index.html",
      "find": "const quarry=this.mode==='campaign' && !first && Quarry.of(g.cleared, dayKey(new Date()))===key;",
      "replace": "const quarry=this.mode==='campaign' && Quarry.of(g.cleared, dayKey(new Date()))===key;",
      "run": "verify"
    },
    {
      "name": "the quarry pays no more",
      "file": "index.html",
      "find": "const full=first || !!this.foe.elite || quarry;",
      "replace": "const full=first || !!this.foe.elite;",
      "run": "verify"
    },
    {
      "name": "the card does not say the quarry",
      "file": "index.html",
      "find": "${Quarry.line(quarry && !this.foe.elite)}",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the map does not mark the quarry's place",
      "file": "index.html",
      "find": "${Quarry.tag(quarry===ri+':'+fi)}",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the map's top does not name the quarry",
      "file": "index.html",
      "find": "      ${Quarry.node(Quarry.today())}\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "every beaten foe's place is marked",
      "file": "index.html",
      "find": "${Quarry.tag(quarry===ri+':'+fi)}",
      "replace": "${Quarry.tag(done && !f.boss)}",
      "run": "play:quarry"
    }
  ]
}