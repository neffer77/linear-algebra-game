      "file": "index.html",
      "find": "ok:K=>K.si===0 && K.K-K.P()<K.K/100},",
      "replace": "ok:K=>K.si===0 && K.K-K.P()<K.K/10},",
      "run": "verify"
    },
    {
      "name": "the above goal needs no step",
      "file": "index.html",
      "find": "ok:K=>K.si===2 && K.stepped}",
      "replace": "ok:K=>K.si===2}",
      "run": "verify"
    }
  ]
}