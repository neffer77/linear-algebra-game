{
  "change": "Letters from home: every tenth victory a letter from Linden Ford, with a draught inside",
  "mutations": [
    {
      "name": "a letter at every fifth victory",
      "file": "index.html",
      "find": "  EVERY: 10, FROM: 'Maren',",
      "replace": "  EVERY: 5, FROM: 'Maren',",
      "run": "verify"
    },
    {
      "name": "a ninth letter that is not there",
      "file": "index.html",
      "find": "  arrived(g){ const w=this.wins(g); return w>0 && w%this.EVERY===0 && w/this.EVERY<=this.L.length ? w/this.EVERY : 0; },",
      "replace": "  arrived(g){ const w=this.wins(g); return w>0 && w%this.EVERY===0 ? w/this.EVERY : 0; },",
      "run": "verify"
    },
    {
      "name": "no draught in the letter",
      "file": "index.html",
      "find": "g.items.potion=(g.items.potion||0)+1; return true; },",
      "replace": "return true; },",
      "run": "verify"
    },
    {
      "name": "a draught with no letter",
      "file": "index.html",
      "find": "  gift(g, n){ if(!n || !g || !g.items) return false;",
      "replace": "  gift(g, n){ if(!g || !g.items) return false;",
      "run": "verify"
    },
    {
      "name": "the page shows a letter not yet come",
      "file": "index.html",
      "find": "      + Array.from({length:n}, (_, i)=>this.letter(i+1)).join('');",
      "replace": "      + Array.from({length:Math.min(N, n+1)}, (_, i)=>this.letter(i+1)).join('');",
      "run": "verify"
    },
    {
      "name": "the page counts past the last letter",
      "file": "index.html",
      "find": "  had(g){ return Math.min(this.L.length, Math.floor(this.wins(g)/this.EVERY)); },",
      "replace": "  had(g){ return Math.floor(this.wins(g)/this.EVERY); },",
      "run": "verify"
    },
    {
      "name": "the card reads the wrong letter",
      "file": "index.html",
      "find": "      <div class=\"sub\" style=\"margin-top:6px;font-size:14px;line-height:1.6;font-style:italic;color:#e8d9b0\">${this.L[n-1]}</div>",
      "replace": "      <div class=\"sub\" style=\"margin-top:6px;font-size:14px;line-height:1.6;font-style:italic;color:#e8d9b0\">${this.L[n%this.L.length]}</div>",
      "run": "verify"
    },
    {
      "name": "the victory gives no letter",
      "file": "index.html",
      "find": "    const letter=Letters.arrived(g); Letters.gift(g, letter);\n",
      "replace": "    const letter=0;\n",
      "run": "verify"
    },
    {
      "name": "the card does not show the letter",
      "file": "index.html",
      "find": "        ${Letters.card(letter)}\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the Saga page keeps no letters",
      "file": "index.html",
      "find": "    if(id==='s-saga'){ Saga.render(); Letters.render(); }",
      "replace": "    if(id==='s-saga'){ Saga.render(); }",
      "run": "verify"
    },
    {
      "name": "no draught in the letter [play]",
      "file": "index.html",
      "find": "g.items.potion=(g.items.potion||0)+1; return true; },",
      "replace": "return true; },",
      "run": "play:letters"
    },
    {
      "name": "the Saga page keeps no letters [play]",
      "file": "index.html",
      "find": "    if(id==='s-saga'){ Saga.render(); Letters.render(); }",
      "replace": "    if(id==='s-saga'){ Saga.render(); }",
      "run": "play:letters"
    }
  ]
}