{
  "change": "A rite's trail draws its mathematics instead of flattening it",
  "mutations": [
    {
      "name": "the trail strips the question's markup again, flattening its matrices",
      "file": "index.html",
      "find": "r.steps.push(`${trailQ(st.q)} → ",
      "replace": "r.steps.push(`${st.q.replace(/<[^>]+>/g,' ').trim().slice(0,44)} → ",
      "run": "play:lesson"
    },
    {
      "name": "a fraction in a rung is flattened",
      "file": "index.html",
      "find": "|<span class=\"frac\"><span>[^<]*<\\/span><span>[^<]*<\\/span><\\/span>|<su[pb]>",
      "replace": "|<su[pb]>",
      "run": "verify"
    },
    {
      "name": "a power in a rung is no longer raised",
      "file": "index.html",
      "find": "|<su[pb]>[^<]*<\\/su[pb]>/g;",
      "replace": "/g;",
      "run": "verify"
    },
    {
      "name": "a long rung is cut inside a word",
      "file": "index.html",
      "find": "out+= sp>0 ? head.slice(0,sp) : '';",
      "replace": "out+= head;",
      "run": "verify"
    },
    {
      "name": "a long rung is never cut",
      "file": "index.html",
      "find": "if(n+t.length<=max){",
      "replace": "if(true){",
      "run": "verify"
    },
    {
      "name": "a cut rung does not say it was cut",
      "file": "index.html",
      "find": "const cut=()=>out.replace(/\\s+$/,'')+'…';",
      "replace": "const cut=()=>out.replace(/\\s+$/,'');",
      "run": "verify"
    },
    {
      "name": "markup that is not mathematics is kept in the trail",
      "file": "index.html",
      "find": "const t=p.t.replace(/<br\\s*\\/?>/g,' ').replace(/<[^>]+>/g,'')",
      "replace": "const t=p.t.replace(/<br\\s*\\/?>/g,' ')",
      "run": "verify"
    },
    {
      "name": "the trail's line is allowed to run long",
      "file": "index.html",
      "find": "function trailQ(html, max=64){",
      "replace": "function trailQ(html, max=90){",
      "run": "verify"
    }
  ]
}
