{
  "change": "A rival: Sir Corvin waits on the road of each realm's strongest foe and offers a duel for double gold",
  "mutations": [
    {
      "name": "the rival rides a boss's road",
      "file": "index.html",
      "find": "fs.forEach((f,i)=>{ if(!f.boss && (best<0 || f.hp>fs[best].hp)) best=i; });",
      "replace": "fs.forEach((f,i)=>{ if(best<0 || f.hp>fs[best].hp) best=i; });",
      "run": "verify"
    },
    {
      "name": "the rival waits before his foe is beaten",
      "file": "index.html",
      "find": "    return fi>=0 && !!c[B.ri+':'+fi];",
      "replace": "    return fi>=0;",
      "run": "verify"
    },
    {
      "name": "the rival waits in the arena too",
      "file": "index.html",
      "find": "    if(!B || B.mode!=='campaign' || this.on(B) || this.beat[B.ri]) return false;",
      "replace": "    if(!B || this.on(B) || this.beat[B.ri]) return false;",
      "run": "verify"
    },
    {
      "name": "a beaten rival waits again",
      "file": "index.html",
      "find": "  won(B){ if(!this.on(B)) return false; this.beat[B.ri]=true; return true; },",
      "replace": "  won(B){ return this.on(B); },",
      "run": "play:rival"
    },
    {
      "name": "the rival pays as his foe does",
      "file": "index.html",
      "find": "gold:Math.round(f.gold*this.GOLD),",
      "replace": "gold:f.gold,",
      "run": "verify"
    },
    {
      "name": "the rival hits no harder",
      "file": "index.html",
      "find": "atk:Math.round(f.atk*this.ATK), boss:false, rival:true});",
      "replace": "atk:f.atk, boss:false, rival:true});",
      "run": "play:rival"
    },
    {
      "name": "the card offers no duel",
      "file": "index.html",
      "find": "        ${Rival.offer(this)}\n",
      "replace": "",
      "run": "play:rival"
    },
    {
      "name": "the duel is the plain foe",
      "file": "index.html",
      "find": "    if(rival){ this._start(Rival.make(ri)); return; }   // asked for: a duel with the rival\n",
      "replace": "",
      "run": "play:rival"
    },
    {
      "name": "the duel starts unsaid",
      "file": "index.html",
      "find": "    else if(Rival.on(this)) UI.toast(Rival.intro());\n",
      "replace": "",
      "run": "play:rival"
    },
    {
      "name": "a won duel is not told",
      "file": "index.html",
      "find": "          ${Rival.line(rival)}\n",
      "replace": "",
      "run": "play:rival"
    }
  ]
}