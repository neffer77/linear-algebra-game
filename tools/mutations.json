{
  "change": "Parry: five right in a row turn away the next miss's blow",
  "mutations": [
    {
      "name": "a parry at every streak",
      "file": "index.html",
      "find": "if(!this.can(B) || B.parry || !B.combo || B.combo%this.AT) return false;",
      "replace": "if(!this.can(B) || B.parry || !B.combo) return false;",
      "run": "verify"
    },
    {
      "name": "two parries held at once",
      "file": "index.html",
      "find": "if(!this.can(B) || B.parry || !B.combo || B.combo%this.AT) return false;",
      "replace": "if(!this.can(B) || !B.combo || B.combo%this.AT) return false;",
      "run": "verify"
    },
    {
      "name": "a parry at four",
      "file": "index.html",
      "find": "  AT: 5,\n  can(B)",
      "replace": "  AT: 4,\n  can(B)",
      "run": "verify"
    },
    {
      "name": "a parry in the daily",
      "file": "index.html",
      "find": "can(B){ return !!(B && B.mode!=='daily' && !B.rite); },",
      "replace": "can(B){ return !!(B && !B.rite); },",
      "run": "verify"
    },
    {
      "name": "a parry is never spent",
      "file": "index.html",
      "find": "B.parry=false; B.parried=true;",
      "replace": "B.parried=true;",
      "run": "verify"
    },
    {
      "name": "a parry turns away nothing",
      "file": "index.html",
      "find": "    if(Parry.turn(this)) return 0;\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "a right answer earns no parry",
      "file": "index.html",
      "find": "      Parry.earn(this);\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "a fight keeps the last fight's parry",
      "file": "index.html",
      "find": "    this.parry=false; this.parryTold=false; this.parried=false;   // a parry lasts the fight\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the explanation does not say the parry",
      "file": "index.html",
      "find": "      Parry.line(!inRite && this.parried)+\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the parry is not shown beside the streak",
      "file": "index.html",
      "find": "streak ${this.combo}`+Parry.tag(this);",
      "replace": "streak ${this.combo}`;",
      "run": "verify"
    },
    {
      "name": "a parried miss still costs health",
      "file": "index.html",
      "find": "    if(Parry.turn(this)) return 0;",
      "replace": "    if(Parry.turn(this)) return raw;",
      "run": "play:parry"
    }
  ]
}