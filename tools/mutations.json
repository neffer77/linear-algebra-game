{
  "change": "Keep figure labels readable where a curve runs under them",
  "mutations": [
    {
      "name": "the labels lose their rim",
      "file": "index.html",
      "find": "[id$=\"Fig\"] svg text{paint-order:stroke;",
      "replace": "[id$=\"Fig\"] svg text{",
      "run": "verify"
    },
    {
      "name": "the rim is drawn in another colour",
      "file": "index.html",
      "find": "svg text{paint-order:stroke;stroke:var(--panel);",
      "replace": "svg text{paint-order:stroke;stroke:var(--gold);",
      "run": "verify"
    }
  ]
}