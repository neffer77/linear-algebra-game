{
  "change": "Turn It Round, mixed: one question from a different workshop's pick mode each time, from the Tome.",
  "mutations": [
    {
      "name": "a pass does not wait for every workshop",
      "file": "index.html",
      "find": "let pool=all.filter(i=>!this.seen.has(i));",
      "replace": "let pool=all.filter(i=>i!==this.cur);",
      "run": "verify"
    },
    {
      "name": "a new pass can start on the last workshop",
      "file": "index.html",
      "find": "if(!pool.length){ this.seen.clear(); pool=all.filter(i=>i!==this.cur); }",
      "replace": "if(!pool.length){ this.seen.clear(); pool=all; }",
      "run": "verify"
    },
    {
      "name": "a dealt workshop is not marked seen",
      "file": "index.html",
      "find": "this.cur=pool[R.i(0,pool.length-1)]; this.seen.add(this.cur);",
      "replace": "this.cur=pool[R.i(0,pool.length-1)];",
      "run": "verify"
    },
    {
      "name": "the pick is not dealt fresh",
      "file": "index.html",
      "find": "const P=this.mod(); P.newRound(); P.last=null;",
      "replace": "const P=this.mod(); P.last=null;",
      "run": "verify"
    },
    {
      "name": "the last working shows on a new question",
      "file": "index.html",
      "find": "const P=this.mod(); P.newRound(); P.last=null;",
      "replace": "const P=this.mod(); P.newRound();",
      "run": "verify"
    },
    {
      "name": "a solve is never noticed",
      "file": "index.html",
      "find": "    this.base=P.matched; this.done=false;",
      "replace": "    this.base=P.matched+1; this.done=false;",
      "run": "verify"
    },
    {
      "name": "a new question opens solved",
      "file": "index.html",
      "find": "this.done=false; this.firstTry=false;\n    this.render();",
      "replace": "this.done=true; this.firstTry=false;\n    this.render();",
      "run": "verify"
    },
    {
      "name": "the workshop behind is redrawn",
      "file": "index.html",
      "find": "    H.render=()=>{};\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the workshop's redraw is not put back",
      "file": "index.html",
      "find": "finally { H.render=real; }",
      "replace": "finally { }",
      "run": "verify"
    },
    {
      "name": "a miss counts as solved",
      "file": "index.html",
      "find": "    if(P.matched>this.base){",
      "replace": "    if(P.matched>=this.base){",
      "run": "verify"
    },
    {
      "name": "first tries are never counted",
      "file": "index.html",
      "find": "this.firstTry=m0===0;",
      "replace": "this.firstTry=false;",
      "run": "verify"
    },
    {
      "name": "every solve is a first try",
      "file": "index.html",
      "find": "this.firstTry=m0===0;",
      "replace": "this.firstTry=true;",
      "run": "verify"
    },
    {
      "name": "the solved count stands still",
      "file": "index.html",
      "find": "this.solved++; if(this.firstTry)",
      "replace": "if(this.firstTry)",
      "run": "verify"
    },
    {
      "name": "the workshops solved from are not counted",
      "file": "index.html",
      "find": "this.from.add(this.cur);\n",
      "replace": "\n",
      "run": "verify"
    },
    {
      "name": "no banner at ten",
      "file": "index.html",
      "find": "if(this.solved===10||this.solved===25",
      "replace": "if(this.solved===25",
      "run": "verify"
    },
    {
      "name": "ids are not prefixed",
      "file": "index.html",
      "find": ".replace(/ id=\"([^\"]+)\"/g,' id=\"mx-$1\"')",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "url(#) is not prefixed",
      "file": "index.html",
      "find": ".replace(/url\\(#/g,'url(#mx-')",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the buttons call the workshop's own choose",
      "file": "index.html",
      "find": ".replace(new RegExp(`onclick=\"${name}\\\\.choose\\\\((\\\\d)\\\\)\"`,'g'),'onclick=\"MixPick.pick($1)\"');",
      "replace": ";",
      "run": "verify"
    },
    {
      "name": "the count line is left in",
      "file": "index.html",
      "find": "return {h:h.slice(0,at)+h.slice(end+6),",
      "replace": "return {h:h,",
      "run": "verify"
    },
    {
      "name": "the workshop is not named",
      "file": "index.html",
      "find": "let out=`<div class=\"small\" id=\"mxFrom\" style=\"margin-bottom:4px\">From the ${t}</div>`;",
      "replace": "let out=`<div class=\"small\" id=\"mxFrom\" style=\"margin-bottom:4px\">From the workshop</div>`;",
      "run": "verify"
    },
    {
      "name": "a solve is not marked a first try",
      "file": "index.html",
      "find": "<b>✓ Solved${this.firstTry?' on the first try':''}.</b>",
      "replace": "<b>✓ Solved.</b>",
      "run": "verify"
    },
    {
      "name": "the working is not shown after a solve",
      "file": "index.html",
      "find": "</b></div>${B.read}</div>`;",
      "replace": "</b></div></div>`;",
      "run": "verify"
    },
    {
      "name": "there is no way on after a solve",
      "file": "index.html",
      "find": "      out+=`<button class=\"btn\" id=\"mxNext\"",
      "replace": "      out+=`<button class=\"btn\" hidden id=\"mxNext\"",
      "run": "verify"
    },
    {
      "name": "there is no skip",
      "file": "index.html",
      "find": "      out+=B.h+`<button class=\"btn sm ghost\" id=\"mxSkip\"",
      "replace": "      out+=B.h+`<button class=\"btn sm ghost\" hidden id=\"mxSkip\"",
      "run": "verify"
    },
    {
      "name": "the score forgets the first tries",
      "file": "index.html",
      "find": "${this.solved} solved this visit, ${this.first} on the first try,",
      "replace": "${this.solved} solved this visit, ${this.solved} on the first try,",
      "run": "verify"
    },
    {
      "name": "the score counts the list, not the solves",
      "file": "index.html",
      "find": "from ${this.from.size} of ${this.LIST.length} workshops.",
      "replace": "from ${this.seen.size} of ${this.LIST.length} workshops.",
      "run": "verify"
    },
    {
      "name": "coming back deals a new question",
      "file": "index.html",
      "find": "  enter(){ if(this.cur<0) this.next(); else this.render(); },",
      "replace": "  enter(){ this.next(); },",
      "run": "verify"
    },
    {
      "name": "a workshop's pick is left out of the mix",
      "file": "index.html",
      "find": "    ['ArrowPick','Arrow',",
      "replace": "    ['ArrowPicked','Arrow',",
      "run": "verify"
    },
    {
      "name": "a workshop is listed with the wrong host",
      "file": "index.html",
      "find": "    ['ChainPick','Chain',",
      "replace": "    ['ChainPick','Slope',",
      "run": "verify"
    },
    {
      "name": "a workshop is listed by the wrong name",
      "file": "index.html",
      "find": "    ['SwapPick','Swap','",
      "replace": "    ['SwapPick','Swap','x",
      "run": "verify"
    },
    {
      "name": "the screen does not deal on opening",
      "file": "index.html",
      "find": "    if(id==='s-mixpick') MixPick.enter();\n",
      "replace": "",
      "run": "verify"
    },
    {
      "name": "the Tome has no way in",
      "file": "index.html",
      "find": "onclick=\"MixPick.open()\">Mix them up</button>",
      "replace": "onclick=\"MixPick.close()\">Mix them up</button>",
      "run": "verify"
    },
    {
      "name": "a pick's readout drops its count line",
      "file": "index.html",
      "find": "    lines.push(`${this.matched} picked this visit, ${this.firstTry} on the first try.`);\n    out+=`<div id=\"awRead\"",
      "replace": "    out+=`<div id=\"awRead\"",
      "run": "verify"
    }
  ]
}