  {
   "name": "the derivative of cos is written as sin",
   "file": "index.html",
   "find": "fs:'cos x', ds:'−sin x', dat:X=>`−sin(${X})`",
   "replace": "fs:'cos x', ds:'sin x', dat:X=>`−sin(${X})`",
   "run": "verify"
  },
  {
   "name": "the true derivative of cos has the wrong sign",
   "file": "index.html",
   "find": "f:Math.cos, d:x=>-Math.sin(x)}",
   "replace": "f:Math.cos, d:x=>Math.sin(x)}",
   "run": "verify"
  },
  {
   "name": "the derivative of ln is written as x",
