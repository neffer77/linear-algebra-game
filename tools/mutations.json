{
  "change": "Add a war path: victories in a row this sitting pay more gold",
  "mutations": [
    {
      "name": "the war path never stops climbing",
      "file": "index.html",
      "find": "bonus(n){ return this.STEP*Math.min(this.CAP, Math.max(0, n-1)); },",
      "replace": "bonus(n){ return this.STEP*Math.max(0, n-1); },",
      "run": "verify"
    },
    {
      "name": "the first victory already pays more",
      "file": "index.html",
      "find": "bonus(n){ return this.STEP*Math.min(this.CAP, Math.max(0, n-1)); },",
      "replace": "bonus(n){ return this.STEP*Math.min(this.CAP, Math.max(0, n)); },",
      "run": "verify"
    },
    {
      "name": "the arena counts toward the path",
      "file": "index.html",
      "find": "const wp=this.mode==='campaign' ? WarPath.won() : 1;",
      "replace": "const wp=WarPath.won();",
      "run": "verify"
    },
    {
      "name": "a fall leaves the path running",
      "file": "index.html",
      "find": "    const path=WarPath.broke();\n    const lost=",
      "replace": "    const path=WarPath.n;\n    const lost=",
      "run": "verify"
    },
    {
      "name": "leaving a won fight ends the path",
      "file": "index.html",
      "find": "const path=live && this.mode==='campaign' ? WarPath.broke() : 0;",
      "replace": "const path=this.mode==='campaign' ? WarPath.broke() : 0;",
      "run": "verify"
    },
    {
      "name": "the line promises the wrong next pay",
      "file": "index.html",
      "find": "Win the next for +${this.pct(n+1)}%.",
      "replace": "Win the next for +${this.pct(n)}%.",
      "run": "verify"
    },
    {
      "name": "the gold is paid at the plain rate",
      "file": "index.html",
      "find": "(Phase.flawless(this)?1.25:1)*wp);",
      "replace": "(Phase.flawless(this)?1.25:1));",
      "run": "play:warpath"
    }
  ]
}