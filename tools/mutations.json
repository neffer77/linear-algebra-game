{
  "change": "Add a Row moves mode to the cofactor workshop: work a matrix down with row moves and track its determinant.",
  "mutations": [
    {
      "name": "a swap that leaves the tally alone",
      "file": "index.html",
      "find": "if(k==='swap'){ [M[t],M[s]]=[M[s],M[t]]; f=this.mul(f,[-1,1]); }",
      "replace": "if(k==='swap'){ [M[t],M[s]]=[M[s],M[t]]; }",
      "run": "verify"
    },
    {
      "name": "a scaling that multiplies the tally instead of dividing it",
      "file": "index.html",
      "find": "M[t]=M[t].map(v=>this.mul(v,m)); f=this.mul(f,[m[1],m[0]]); }",
      "replace": "M[t]=M[t].map(v=>this.mul(v,m)); f=this.mul(f,m); }",
      "run": "verify"
    },
    {
      "name": "an addition that adds the row the other way round",
      "file": "index.html",
      "find": "M[t]=M[t].map((v,j)=>this.add(v,this.mul([c,1],M[s][j]))); }",
      "replace": "M[t]=M[t].map((v,j)=>this.add(M[s][j],this.mul([c,1],v))); }",
      "run": "verify"
    },
    {
      "name": "triangular read without the last entry below the diagonal",
      "file": "index.html",
      "find": "if(!M[1][0][0] && !M[2][0][0] && !M[2][1][0]) return 'up';",
      "replace": "if(!M[1][0][0] && !M[2][0][0]) return 'up';",
      "run": "verify"
    },
    {
      "name": "a 0 on the diagonal left without its swap",
      "file": "index.html",
      "find": "if(M[j][j][0]===0) s+=",
      "replace": "if(M[j][j][0]===9) s+=",
      "run": "verify"
    },
    {
      "name": "scalings counted as swaps",
      "file": "index.html",
      "find": "${this.cnt(c(['swap']),'swap','swaps')}",
      "replace": "${this.cnt(c(['swap','neg']),'swap','swaps')}",
      "run": "verify"
    },
    {
      "name": "the row used outlined as the row changed",
      "file": "index.html",
      "find": "stroke=\"${role==='t'?FIG_COL.b:role==='s'?FIG_COL.a:'none'}\"",
      "replace": "stroke=\"${role==='t'||role==='s'?FIG_COL.b:'none'}\"",
      "run": "verify"
    },
    {
      "name": "a cleared entry still drawn red",
      "file": "index.html",
      "find": "stroke=\"${below?(z?FIG_COL.c:FIG_COL.d):FIG_COL.grid}\"",
      "replace": "stroke=\"${below?FIG_COL.d:FIG_COL.grid}\"",
      "run": "verify"
    },
    {
      "name": "additions alone that count a swap",
      "file": "index.html",
      "find": "K.hist.every(h=>['plus','minus'].includes(h.move.k))}",
      "replace": "K.hist.some(h=>['plus','minus'].includes(h.move.k))}",
      "run": "verify"
    },
    {
      "name": "no move shut for running too far",
      "file": "index.html",
      "find": "if(M.flat().some(v=>Math.abs(v[0])>999||v[1]>64)) return null;",
      "replace": "if(M.flat().some(v=>Math.abs(v[0])>99999||v[1]>9999)) return null;",
      "run": "verify"
    },
    {
      "name": "undo that leaves the tally where it was",
      "file": "index.html",
      "find": "this.hist.pop(); if(!h) return; this.M=h.M; this.f=h.f;",
      "replace": "this.hist.pop(); if(!h) return; this.M=h.M;",
      "run": "verify"
    }
  ]
}