{
  "change": "Add a Growing or shrinking mode to the logistic workshop",
  "mutations": [
    {
      "name": "the sign is read off P alone",
      "file": "index.html",
      "find": "truth(i){ return Math.sign(this.P(i)*(this.K(i)-this.P(i))); },",
      "replace": "truth(i){ return Math.sign(this.P(i)); },",
      "run": "verify"
    },
    {
      "name": "the room left is P/K",
      "file": "index.html",
      "find": "room(i){ return 1-this.P(i)/this.K(i); },",
      "replace": "room(i){ return this.P(i)/this.K(i); },",
      "run": "verify"
    },
    {
      "name": "the rate drops the r",
      "file": "index.html",
      "find": "rate(i,P=this.P(i)){ return this.r(i)*P*(1-P/this.K(i)); },",
      "replace": "rate(i,P=this.P(i)){ return P*(1-P/this.K(i)); },",
      "run": "verify"
    },
    {
      "name": "above the ceiling means above 1000",
      "file": "index.html",
      "find": "overs(){ return [0,1,2,3].filter(i=>this.P(i)>this.K(i)); },",
      "replace": "overs(){ return [0,1,2,3].filter(i=>this.P(i)>1000); },",
      "run": "verify"
    },
    {
      "name": "a population of 0 is not looked for",
      "file": "index.html",
      "find": "zeros(){ return [0,1,2,3].filter(i=>this.P(i)===0); },",
      "replace": "zeros(){ return []; },",
      "run": "verify"
    },
    {
      "name": "the curve is drawn before the round is right",
      "file": "index.html",
      "find": "if(this.solved){\n        out+=`<line data-k=\"axis\"",
      "replace": "if(true){\n        out+=`<line data-k=\"axis\"",
      "run": "verify"
    },
    {
      "name": "P is dotted at K",
      "file": "index.html",
      "find": "cx=\"${f(px(this.P(i)))}\" cy=\"${f(py(this.rate(i)))}\"",
      "replace": "cx=\"${f(px(K))}\" cy=\"${f(py(this.rate(i)))}\"",
      "run": "verify"
    },
    {
      "name": "a call still moves once the round is right",
      "file": "index.html",
      "find": "if(this.solved || this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    LogiGrow.render();",
      "replace": "if(this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    LogiGrow.render();",
      "run": "verify"
    }
  ]
}