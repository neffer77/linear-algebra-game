{
  "change": "A familiar: twenty right answers in a sitting hatch an egg, and the familiar mends a little health on each right answer",
  "mutations": [
    {
      "name": "the egg hatches at ten",
      "file": "index.html",
      "find": "  HATCH: 20, GROWN: 60, MEND: 0.03,",
      "replace": "  HATCH: 10, GROWN: 60, MEND: 0.03,",
      "run": "verify"
    },
    {
      "name": "the familiar never grows",
      "file": "index.html",
      "find": "  HATCH: 20, GROWN: 60, MEND: 0.03,",
      "replace": "  HATCH: 20, GROWN: 1e9, MEND: 0.03,",
      "run": "verify"
    },
    {
      "name": "the familiar mends nothing",
      "file": "index.html",
      "find": "  HATCH: 20, GROWN: 60, MEND: 0.03,",
      "replace": "  HATCH: 20, GROWN: 60, MEND: 0,",
      "run": "verify"
    },
    {
      "name": "a familiar mends past full",
      "file": "index.html",
      "find": "    const was=g.hp; g.hp=Math.min(g.maxHp, g.hp+this.amount(g.maxHp));",
      "replace": "    const was=g.hp; g.hp=g.hp+this.amount(g.maxHp);",
      "run": "verify"
    },
    {
      "name": "the egg counts arena and daily answers",
      "file": "index.html",
      "find": "  can(B){ return !!(B && B.mode==='campaign' && !B.rite); },\n  hatched()",
      "replace": "  can(B){ return !!B; },\n  hatched()",
      "run": "verify"
    },
    {
      "name": "the egg mends before it hatches",
      "file": "index.html",
      "find": "    if(!this.hatched()) return 0;\n    if(this.n===this.GROWN)",
      "replace": "    if(this.n===this.GROWN)",
      "run": "verify"
    },
    {
      "name": "a familiar mends a fallen knight",
      "file": "index.html",
      "find": "    const g=Game.s; if(!g || g.hp<=0) return 0;",
      "replace": "    const g=Game.s; if(!g) return 0;",
      "run": "verify"
    },
    {
      "name": "a grown familiar mends no more",
      "file": "index.html",
      "find": "Math.round(maxHp*this.MEND*(this.grown()?2:1))",
      "replace": "Math.round(maxHp*this.MEND)",
      "run": "verify"
    },
    {
      "name": "right answers are not counted",
      "file": "index.html",
      "find": "      Familiar.add(this);   // the egg's count, or the familiar's mending\n",
      "replace": "",
      "run": "play:familiar"
    },
    {
      "name": "the streak line hides the familiar",
      "file": "index.html",
      "find": "    document.getElementById('comboTxt').textContent += Familiar.tag(this);   // the egg, or the familiar\n",
      "replace": "",
      "run": "play:familiar"
    },
    {
      "name": "the egg hatches unsaid",
      "file": "index.html",
      "find": "      Celebrate.banner('THE EGG HATCHES', `a ${this.kind.nm} joins you for this sitting`, '#9fe6b8', ()=>Sfx.milestone());\n",
      "replace": "",
      "run": "play:familiar"
    }
  ]
}
