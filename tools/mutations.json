{
  "change": "Add a Faster or slower mode to the ladder workshop",
  "mutations": [
    {
      "name": "the top is compared with half the ladder",
      "file": "index.html",
      "find": "truth(i){ return Math.sign(2*this.x(i)**2-this.L2(i)); },",
      "replace": "truth(i){ return Math.sign(2*this.x(i)-this.len(i)); },",
      "run": "verify"
    },
    {
      "name": "the top's height adds x² instead of taking it away",
      "file": "index.html",
      "find": "y2(i){ return this.L2(i)-this.x(i)**2; },",
      "replace": "y2(i){ return this.L2(i)+this.x(i)**2; },",
      "run": "verify"
    },
    {
      "name": "x/y is turned upside down",
      "file": "index.html",
      "find": "ratio(i){ return this.x(i)/this.y(i); },",
      "replace": "ratio(i){ return this.y(i)/this.x(i); },",
      "run": "verify"
    },
    {
      "name": "past halfway needs no slower top",
      "file": "index.html",
      "find": "pasts(){ return [0,1,2,3].filter(i=>this.truth(i)===-1 && 4*this.x(i)**2>this.L2(i)); },",
      "replace": "pasts(){ return [0,1,2,3].filter(i=>4*this.x(i)**2>this.L2(i)); },",
      "run": "verify"
    },
    {
      "name": "a fast foot starts at 2 m/s",
      "file": "index.html",
      "find": "quicks(){ return [0,1,2,3].filter(i=>this.truth(i)===-1 && this.v(i)>=3); },",
      "replace": "quicks(){ return [0,1,2,3].filter(i=>this.truth(i)===-1 && this.v(i)>=2); },",
      "run": "verify"
    },
    {
      "name": "the ladder is drawn before the round is right",
      "file": "index.html",
      "find": "if(this.solved){\n        out+=`<line data-k=\"ladder\"",
      "replace": "if(true){\n        out+=`<line data-k=\"ladder\"",
      "run": "verify"
    },
    {
      "name": "the top is drawn x up instead of y",
      "file": "index.html",
      "find": "fx=gx+this.x(i)*k, ty=gy-this.y(i)*k;",
      "replace": "fx=gx+this.x(i)*k, ty=gy-this.x(i)*k;",
      "run": "verify"
    },
    {
      "name": "a call still moves once the round is right",
      "file": "index.html",
      "find": "if(this.solved || this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    Ladder.render();",
      "replace": "if(this.calls[i]===c) return;\n    this.calls=this.calls.slice(); this.calls[i]=c; this.touched=true;\n    if(this.marks) this.marks[i]=null;\n    Ladder.render();",
      "run": "verify"
    }
  ]
}