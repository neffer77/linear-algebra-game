{
  "name": "knights-of-the-eigenrealm",
  "version": "1.0.0",
  "private": true,
  "description": "A turn-based knight battler whose combat system is linear algebra and calculus.",
  "scripts": {
    "test": "node tools/verify.js",
    "test:quick": "node tools/verify.js --reps 60",
    "test:play": "node tools/play.js",
    "test:all": "npm test && npm run test:play",
    "build": "node build-scriptable.js",
    "balance": "node tools/balance.js",
    "shots": "node tools/shots.js",
    "audit:shots": "node tools/shots.js --out tools/audit/shots && node tools/audit/build-shots.js",
    "audit": "node tools/audit/assemble.js && node tools/audit/check.js"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
